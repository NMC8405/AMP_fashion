@using Microsoft.AspNetCore.Identity
@using AMPFashionStore.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isBoSuuTap = string.Equals(currentController, "SanPham", StringComparison.OrdinalIgnoreCase)
                   && string.Equals(currentAction, "BoSuuTap", StringComparison.OrdinalIgnoreCase);
    bool isKhuyenMai = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(currentAction, "KhuyenMai", StringComparison.OrdinalIgnoreCase);
    bool isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && !isKhuyenMai;
    bool isSanPham = string.Equals(currentController, "SanPham", StringComparison.OrdinalIgnoreCase) && !isBoSuuTap;
    bool isLienHe = string.Equals(currentController, "LienHe", StringComparison.OrdinalIgnoreCase);

    int soLuongGio = 0, soLuongYeuThich = 0, soLuongThongBao = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var uid = User.GetUserId();
        soLuongGio = await Db.GioHangItems.Where(g => g.NguoiDungId == uid).CountAsync();
        soLuongYeuThich = await Db.YeuThichs.CountAsync(y => y.NguoiDungId == uid);
        soLuongThongBao = await Db.ThongBaos.CountAsync(t => t.NguoiDungId == uid && !t.DaDoc);
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AMP Fashion Store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="amp-header">
        <div class="amp-container amp-header-inner">
            <button class="amp-mobile-toggle" type="button" aria-label="Menu"><i class="bi bi-list"></i></button>
            <a asp-controller="Home" asp-action="Index" class="amp-logo">AMP</a>

            <nav class="amp-nav">
                <a asp-controller="Home" asp-action="Index" class="@(isHome ? "active" : "")">Trang chủ</a>
                <a asp-controller="SanPham" asp-action="DanhSach" class="@(isSanPham ? "active" : "")">Sản phẩm</a>
                <a asp-controller="SanPham" asp-action="BoSuuTap" class="@(isBoSuuTap ? "active" : "")">Bộ sưu tập</a>
                <a asp-controller="Home" asp-action="KhuyenMai" class="@(isKhuyenMai ? "active" : "")">Khuyến mãi</a>
                <a asp-controller="LienHe" asp-action="Index" class="@(isLienHe ? "active" : "")">Liên hệ</a>
            </nav>

            <div class="amp-icons">
                <button class="amp-icon-btn" type="button" data-toggle-search title="Tìm kiếm"><i class="bi bi-search"></i></button>
                <a class="amp-icon-btn" asp-controller="YeuThich" asp-action="Index" title="Yêu thích">
                    <i class="bi bi-heart"></i>
                    @if (soLuongYeuThich > 0) { <span class="amp-icon-badge">@soLuongYeuThich</span> }
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="amp-icon-btn position-relative" asp-controller="TaiKhoan" asp-action="ThongBao" title="Thông báo của tôi">
                        <i class="bi bi-bell"></i>
                        @if (soLuongThongBao > 0) { <span class="amp-icon-badge" style="background:#dc2626">@soLuongThongBao</span> }
                    </a>
                }
                <a class="amp-icon-btn" asp-controller="DonHang" asp-action="DanhSach" title="Đơn hàng của tôi"><i class="bi bi-bag-check"></i></a>
                <a class="amp-icon-btn" asp-controller="GioHang" asp-action="Index" title="Giỏ hàng">
                    <i class="bi bi-bag"></i>
                    @if (soLuongGio > 0) { <span class="amp-icon-badge">@soLuongGio</span> }
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="amp-icon-btn" type="button" data-bs-toggle="dropdown" title="Tài khoản"><i class="bi bi-person"></i></button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">Xin chào, @User.Identity.Name</h6></li>
                            @if (User.IsInRole("NhanVien") || User.IsInRole("QuanTriVien"))
                            {
                                <li><a class="dropdown-item" href="/QuanLy/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Trang quản lý</a></li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="ThongTinCaNhan"><i class="bi bi-person-circle me-2"></i>Thông tin cá nhân</a></li>
                            <li><a class="dropdown-item d-flex justify-content-between align-items-center" asp-controller="TaiKhoan" asp-action="ThongBao"><span><i class="bi bi-bell me-2"></i>Thông báo</span>@if (soLuongThongBao > 0) { <span class="badge bg-danger rounded-pill" style="font-size:10px">@soLuongThongBao</span> }</a></li>
                            <li><a class="dropdown-item" asp-controller="DonHang" asp-action="DanhSach"><i class="bi bi-bag-check me-2"></i>Đơn hàng của tôi</a></li>
                            <li><a class="dropdown-item" asp-controller="YeuThich" asp-action="Index"><i class="bi bi-heart me-2"></i>Yêu thích</a></li>
                            <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DoiMatKhau"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="px-2">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="amp-icon-btn" asp-controller="TaiKhoan" asp-action="DangNhap" title="Đăng nhập"><i class="bi bi-person"></i></a>
                }
            </div>
        </div>
        <div class="amp-search-bar">
            <div class="amp-container">
                <form asp-controller="SanPham" asp-action="DanhSach" method="get">
                    <input type="text" name="tuKhoa" class="form-control" placeholder="Tìm kiếm sản phẩm, thương hiệu..." autocomplete="off" />
                    <button type="submit" class="amp-btn amp-btn-primary"><i class="bi bi-search"></i></button>
                </form>
            </div>
        </div>
    </header>

    <main>
        @if (TempData["ThongBao"] != null)
        {
            <div class="amp-container" style="padding-top:20px">
                <div class="amp-alert amp-alert-success" data-auto-dismiss><i class="bi bi-check-circle me-1"></i> @TempData["ThongBao"]</div>
            </div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="amp-container" style="padding-top:20px">
                <div class="amp-alert amp-alert-danger" data-auto-dismiss><i class="bi bi-exclamation-circle me-1"></i> @TempData["Loi"]</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="amp-footer">
        <div class="amp-container amp-footer-main">
            <div>
                <a asp-controller="Home" asp-action="Index" class="amp-footer-logo">AMP</a>
                <p>Thương hiệu thời trang tối giản đương đại. AMP định hình phong cách qua chất liệu chọn lọc và những phom dáng vượt thời gian.</p>
                <div class="amp-social">
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="Youtube"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
            <div>
                <h5>Về chúng tôi</h5>
                <ul>
                    <li><a href="#">Về AMP</a></li>
                    <li><a href="#">Phát triển bền vững</a></li>
                    <li><a href="#">Tuyển dụng</a></li>
                    <li><a href="#">Blog thời trang</a></li>
                </ul>
            </div>
            <div>
                <h5>Hỗ trợ</h5>
                <ul>
                    <li><a href="#">Chính sách giao hàng</a></li>
                    <li><a href="#">Chính sách đổi trả</a></li>
                    <li><a href="#">Hướng dẫn chọn size</a></li>
                    <li><a asp-controller="LienHe" asp-action="Index">Câu hỏi thường gặp</a></li>
                </ul>
            </div>
            <div>
                <h5>Liên hệ</h5>
                <ul>
                    <li><i class="bi bi-geo-alt me-1"></i> 128 Nguyễn Trãi, Q.1, TP.HCM</li>
                    <li><i class="bi bi-telephone me-1"></i> Hotline: 1900 6006</li>
                    <li><i class="bi bi-envelope me-1"></i> support@ampfashion.vn</li>
                </ul>
            </div>
        </div>
        <div class="amp-container amp-footer-bottom">
            <span>&copy; @DateTime.Now.Year AMP Fashion. Tất cả quyền được bảo lưu.</span>
            <span>
                <a href="#">Chính sách bảo mật</a>
                <a href="#">Điều khoản sử dụng</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
