@model List<DanhMuc>
@{
    ViewData["Title"] = "Bộ sưu tập";
    var anhs = new[] { 
        "https://images.unsplash.com/photo-1602810318383-e386cc2a3ccf?q=80&w=900&auto=format&fit=crop", // Áo Nam
        "https://images.unsplash.com/photo-1584273143981-41c073dfe8f8?q=80&w=900&auto=format&fit=crop", // Áo Nữ
        "https://images.unsplash.com/photo-1542272604-780c96856592?q=80&w=900&auto=format&fit=crop", // Quần
        "https://images.unsplash.com/photo-1496747611176-843222e1e57c?q=80&w=900&auto=format&fit=crop", // Váy Đầm
        "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=900&auto=format&fit=crop"  // Phụ kiện
    };
}
<div class="amp-container" style="padding:50px 24px 90px">
    <div class="amp-section-title">
        <h2>Bộ sưu tập</h2>
        <p>Khám phá phong cách theo từng dòng sản phẩm của AMP</p>
    </div>

    <div class="row g-3">
        @for (int i = 0; i < Model.Count; i++)
        {
            var dm = Model[i];
            <div class="col-md-6">
                <div class="amp-category-card" style="height:420px;background-image:linear-gradient(rgba(0,0,0,0.1),rgba(0,0,0,0.65)), url('@(anhs[i % anhs.Length])');background-size:cover;background-position:center;">
                    <div class="cc-body">
                        <h3 style="font-size:22px">@dm.TenDanhMuc</h3>
                        <p style="color:#eee;font-size:12.5px;margin-bottom:10px">@(dm.SanPhams?.Count ?? 0) sản phẩm</p>
                        <a asp-controller="SanPham" asp-action="DanhSach" asp-route-danhMucId="@dm.Id">Khám phá bộ sưu tập →</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
