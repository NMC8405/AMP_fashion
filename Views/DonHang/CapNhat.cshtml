@model CapNhatDonHangViewModel
@{
    ViewData["Title"] = "Cập nhật đơn hàng";
    ViewBag.SidebarActive = "orders";
}
<div class="amp-container" style="padding:40px 24px 90px">
    <div class="amp-page-title">
        <a asp-action="ChiTiet" asp-route-id="@Model.DonHangId" class="back"><i class="bi bi-arrow-left"></i></a>
        <div>Cập nhật thông tin nhận hàng</div>
    </div>

    <div class="amp-account-wrap">
        <partial name="_TaiKhoanSidebar" />

        <div class="amp-card" style="max-width:560px">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <form asp-action="CapNhat" method="post">
                <input type="hidden" asp-for="DonHangId" />
                <div class="amp-field">
                    <label asp-for="TenNguoiNhan" class="amp-label"></label>
                    <input asp-for="TenNguoiNhan" class="form-control" />
                    <span asp-validation-for="TenNguoiNhan" class="text-danger"></span>
                </div>
                <div class="amp-field">
                    <label asp-for="SoDienThoaiNhan" class="amp-label"></label>
                    <input asp-for="SoDienThoaiNhan" class="form-control" />
                    <span asp-validation-for="SoDienThoaiNhan" class="text-danger"></span>
                </div>
                <div class="amp-field">
                    <label asp-for="DiaChiNhan" class="amp-label"></label>
                    <textarea asp-for="DiaChiNhan" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="DiaChiNhan" class="text-danger"></span>
                </div>
                <div class="amp-field">
                    <label asp-for="GhiChu" class="amp-label"><span class="opt">(tùy chọn)</span></label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="amp-btn amp-btn-primary">Lưu thay đổi</button>
                    <a asp-action="ChiTiet" asp-route-id="@Model.DonHangId" class="amp-btn amp-btn-outline">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
