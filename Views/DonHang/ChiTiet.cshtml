@model DonHang
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    ViewBag.SidebarActive = "orders";
    var daDanhGia = ViewBag.SanPhamDaDanhGia as List<int> ?? new();
    var danhGiaCuaDon = ViewBag.DanhGiaCuaDonHang as List<DanhGia> ?? new();

    (string label, string css)[] Buoc()
    {
        if (Model.TrangThaiDonHang == TrangThaiDonHang.DaHuy)
            return new[] { ("Đặt hàng", "done"), ("Đã hủy", "cancelled") };
        return new[]
        {
            ("Đặt hàng", "done"),
            ("Xác nhận", Model.TrangThaiDonHang >= TrangThaiDonHang.DaXacNhan ? "done" : ""),
            ("Đang giao", Model.TrangThaiDonHang >= TrangThaiDonHang.DangGiao ? "done" : ""),
            ("Hoàn tất", Model.TrangThaiDonHang >= TrangThaiDonHang.DaGiao ? "done" : "")
        };
    }
}
<div class="amp-container" style="padding:40px 24px 90px">
    <div class="amp-page-title">
        <a asp-action="DanhSach" class="back"><i class="bi bi-arrow-left"></i></a>
        <div>Chi tiết đơn hàng <small>@Model.MaDonHang</small></div>
    </div>

    <div class="amp-account-wrap">
        <partial name="_TaiKhoanSidebar" />

        <div>
            <div class="amp-card mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <strong>@Model.MaDonHang</strong>
                        <div style="color:var(--amp-muted);font-size:12.5px">Đặt lúc @Model.NgayDat.ToString("HH:mm dd/MM/yyyy")</div>
                    </div>
                    <span class="amp-status amp-status-@Model.CssTrangThai">@Model.TenTrangThai</span>
                </div>

                <div class="amp-tracker">
                    @foreach (var (label, css) in Buoc())
                    {
                        <div class="step @css">
                            <div class="dot"><i class="bi @(css == "done" ? "bi-check-lg" : css == "cancelled" ? "bi-x-lg" : "")"></i></div>
                            <div class="label">@label</div>
                        </div>
                    }
                </div>

                @if (Model.TrangThaiDonHang == TrangThaiDonHang.DaHuy && !string.IsNullOrEmpty(Model.LyDoHuy))
                {
                    <div class="amp-alert amp-alert-danger">Lý do hủy: @Model.LyDoHuy</div>
                }

                <div class="d-flex gap-2 flex-wrap mt-2">
                    @if (Model.ChoPhepSuaThongTin)
                    {
                        <a asp-action="CapNhat" asp-route-id="@Model.Id" class="amp-btn amp-btn-outline amp-btn-sm">Cập nhật thông tin</a>
                    }
                    @if (Model.ChoPhepHuy)
                    {
                        <button type="button" class="amp-btn amp-btn-danger amp-btn-sm" data-bs-toggle="modal" data-bs-target="#modalHuy">Hủy đơn hàng</button>
                    }
                    @if (Model.TrangThaiDonHang == TrangThaiDonHang.DangGiao)
                    {
                        <form asp-action="XacNhanDaNhan" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="amp-btn amp-btn-primary amp-btn-sm">Đã nhận được hàng</button>
                        </form>
                    }
                </div>
            </div>

            @if (ViewBag.QrUrl != null && ViewBag.BankSettings != null && Model.TrangThaiThanhToan == TrangThaiThanhToan.ChuaThanhToan && Model.TrangThaiDonHang != TrangThaiDonHang.DaHuy)
            {
                var bank = ViewBag.BankSettings as AMPFashionStore.Services.BankSettings;
                <div class="amp-card mb-3" style="border: 2px dashed #059669; background: #f0fdf4;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                        <div>
                            <h3 class="amp-heading-sm mb-1" style="color: #065f46;"><i class="bi bi-qr-code-scan me-2"></i>Thanh toán qua mã QR Ngân hàng</h3>
                            <p style="font-size: 13px; color: #047857; margin: 0;">Quét mã VietQR dưới đây để thanh toán cho đơn hàng. Hệ thống sẽ xác nhận ngay sau khi nhận tiền.</p>
                        </div>
                        <span class="badge bg-success" style="font-size: 12px; padding: 6px 12px;">Đang chờ thanh toán</span>
                    </div>
                    <div class="row align-items-center g-4">
                        <div class="col-md-4 text-center">
                            <div style="background:#fff;padding:12px;border-radius:8px;display:inline-block;box-shadow:0 2px 8px rgba(0,0,0,0.08);border:1px solid #d1fae5">
                                <img src="@ViewBag.QrUrl" alt="Mã QR thanh toán" style="max-width:180px;height:auto;display:block" />
                            </div>
                            <div style="font-size:11.5px;color:#065f46;margin-top:8px;font-weight:600"><i class="bi bi-camera me-1"></i>Mở App ngân hàng để quét</div>
                        </div>
                        <div class="col-md-8">
                            <div class="amp-bank-info" style="background:#fff;border-radius:8px;padding:16px;border:1px solid #d1fae5">
                                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Ngân hàng</span><strong style="color:#111827">Vietcombank</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Số tài khoản</span><strong style="color:#111827;font-family:monospace;font-size:14px">@bank?.AccountNumber</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Chủ tài khoản</span><strong style="color:#111827">@bank?.AccountName</strong></div>
                                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Số tiền thanh toán</span><strong style="color:#059669;font-size:15px">@Model.TongTien.ToString("N0")₫</strong></div>
                                <div class="d-flex justify-content-between py-1"><span class="text-muted">Nội dung chuyển khoản</span><strong style="color:#dc2626;font-family:monospace;font-size:14px">@Model.MaDonHang</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="amp-card mb-3">
                <h2 class="amp-heading-sm mb-3">Thông tin nhận hàng</h2>
                <div class="amp-summary-row"><span>Người nhận</span><span>@Model.TenNguoiNhan</span></div>
                <div class="amp-summary-row"><span>Điện thoại</span><span>@Model.SoDienThoaiNhan</span></div>
                <div class="amp-summary-row"><span>Địa chỉ</span><span style="max-width:60%;text-align:right">@Model.DiaChiNhan</span></div>
                @if (!string.IsNullOrEmpty(Model.GhiChu))
                {
                    <div class="amp-summary-row"><span>Ghi chú</span><span>@Model.GhiChu</span></div>
                }
                <div class="amp-summary-row"><span>Thanh toán</span><span>@(Model.PhuongThucThanhToan == PhuongThucThanhToan.ThanhToanKhiNhanHang ? "Khi nhận hàng (COD)" : "Chuyển khoản ngân hàng") — @(Model.TrangThaiThanhToan == TrangThaiThanhToan.DaThanhToan ? "Đã thanh toán" : Model.TrangThaiThanhToan == TrangThaiThanhToan.DaHoanTien ? "Đã hoàn tiền" : "Chưa thanh toán")</span></div>
            </div>

            <div class="amp-card">
                <h2 class="amp-heading-sm mb-3">Sản phẩm (@Model.ChiTietDonHangs.Count)</h2>
                @foreach (var ct in Model.ChiTietDonHangs)
                {
                    <div class="d-flex gap-3 align-items-center mb-3 pb-3" style="border-bottom:1px solid var(--amp-border)">
                        <img src="@(string.IsNullOrEmpty(ct.HinhAnh) ? "/images/placeholder.svg" : ct.HinhAnh)" class="amp-thumb-sm" onerror="this.onerror=null;this.src='/images/placeholder.svg';" style="width:56px;height:68px;object-fit:cover;border-radius:4px" alt="@ct.TenSanPham" />
                        <div class="flex-grow-1">
                            <div style="font-weight:600;font-size:13.5px">@ct.TenSanPham</div>
                            <div style="font-size:12px;color:var(--amp-muted)">@ct.TenMau · @ct.TenKichThuoc · SL: @ct.SoLuong</div>
                        </div>
                        <div style="font-weight:700;font-size:13.5px">@ct.ThanhTien.ToString("N0")₫</div>
                        @if (Model.ChoPhepDanhGia && ct.SanPhamId.HasValue)
                        {
                            if (daDanhGia.Contains(ct.SanPhamId.Value))
                            {
                                <button type="button" class="amp-btn amp-btn-outline amp-btn-sm" data-bs-toggle="modal" data-bs-target="#modalXemDanhGia@(ct.SanPhamId)">
                                    <i class="bi bi-chat-left-dots me-1"></i>Xem đánh giá & phản hồi
                                </button>
                            }
                            else
                            {
                                <button type="button" class="amp-btn amp-btn-outline amp-btn-sm" data-bs-toggle="modal" data-bs-target="#modalDanhGia@(ct.SanPhamId)">Đánh giá</button>
                            }
                        }
                    </div>
                }

                <div class="amp-summary-row"><span>Tạm tính</span><span>@Model.TamTinh.ToString("N0")₫</span></div>
                <div class="amp-summary-row"><span>Phí vận chuyển</span><span>@(Model.PhiVanChuyen == 0 ? "Miễn phí" : Model.PhiVanChuyen.ToString("N0") + "₫")</span></div>
                @if (Model.SoTienGiamGia > 0)
                {
                    <div class="amp-summary-row"><span>Giảm giá @(Model.MaGiamGiaApDung != null ? $"({Model.MaGiamGiaApDung.Ma})" : "")</span><span class="neg">-@Model.SoTienGiamGia.ToString("N0")₫</span></div>
                }
                <div class="amp-summary-row total"><span>Tổng thanh toán</span><span>@Model.TongTien.ToString("N0")₫</span></div>
            </div>
        </div>
    </div>
</div>

@* ============ MODAL: HỦY ĐƠN ============ *@
<div class="modal fade" id="modalHuy" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="DonHang" asp-action="Huy" method="post">
                <input type="hidden" name="DonHangId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Hủy đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="amp-label">Lý do hủy đơn</label>
                    <select name="LyDoHuy" class="form-select" required>
                        <option value="">— Chọn lý do —</option>
                        <option>Tôi muốn thay đổi sản phẩm / số lượng</option>
                        <option>Tôi tìm được giá tốt hơn</option>
                        <option>Thời gian giao hàng quá lâu</option>
                        <option>Tôi đặt nhầm</option>
                        <option>Lý do khác</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="amp-btn amp-btn-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="amp-btn amp-btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ============ MODAL: ĐÁNH GIÁ (mỗi sản phẩm 1 modal) ============ *@
@if (Model.ChoPhepDanhGia)
{
    @foreach (var ct in Model.ChiTietDonHangs.Where(c => c.SanPhamId.HasValue && !daDanhGia.Contains(c.SanPhamId!.Value)))
    {
        <div class="modal fade" id="modalDanhGia@(ct.SanPhamId)" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-controller="DonHang" asp-action="GuiDanhGia" method="post" id="formDanhGia@(ct.SanPhamId)" onsubmit="return handleKiemTraDanhGia(event, @(ct.SanPhamId))">
                        <input type="hidden" name="DonHangId" value="@Model.Id" />
                        <input type="hidden" name="SanPhamId" value="@ct.SanPhamId" />
                        <input type="hidden" name="XacNhanGuiTieuCuc" id="xacNhanGuiTieuCuc@(ct.SanPhamId)" value="false" />
                        <div class="modal-header">
                            <h5 class="modal-title">Đánh giá: @ct.TenSanPham</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="amp-star-pick" data-star-picker="danhgia@(ct.SanPhamId)">
                                <input type="hidden" name="SoSao" id="soSao@(ct.SanPhamId)" value="5" data-star-value />
                                <i class="bi bi-star-fill s on"></i><i class="bi bi-star-fill s on"></i><i class="bi bi-star-fill s on"></i><i class="bi bi-star-fill s on"></i><i class="bi bi-star-fill s on"></i>
                            </div>
                            <label class="amp-label">Nhận xét của bạn</label>
                            <textarea name="NoiDung" id="noiDung@(ct.SanPhamId)" class="form-control" rows="3" required placeholder="Chia sẻ cảm nhận của bạn về sản phẩm..."></textarea>
                            <div class="form-text" style="font-size:12px;color:var(--amp-muted)">
                                <i class="bi bi-shield-check me-1"></i>Bình luận được tự động phân tích cảm xúc bởi mô hình AI PhoBERT.
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="amp-btn amp-btn-outline" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" id="btnSubmitDanhGia@(ct.SanPhamId)" class="amp-btn amp-btn-primary">Gửi đánh giá</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @foreach (var ct in Model.ChiTietDonHangs.Where(c => c.SanPhamId.HasValue && daDanhGia.Contains(c.SanPhamId!.Value)))
    {
        var dg = danhGiaCuaDon.FirstOrDefault(d => d.SanPhamId == ct.SanPhamId!.Value);
        if (dg != null)
        {
            <div class="modal fade" id="modalXemDanhGia@(ct.SanPhamId)" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Đánh giá: @ct.TenSanPham</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            @* Trạng thái kiểm duyệt AI *@
                            @if (dg.TrangThai == TrangThaiDanhGia.ChoDuyet)
                            {
                                <div class="p-3 mb-3 rounded-3" style="background:#fffbeb;border:1px solid #fde68a;font-size:12.5px;color:#92400e">
                                    <div class="d-flex align-items-center gap-2 fw-bold mb-1">
                                        <i class="bi bi-hourglass-split text-warning fs-5"></i>
                                        <span>Đang chờ Quản trị viên duyệt (Cảnh báo tiêu cực)</span>
                                    </div>
                                    <div style="line-height:1.45">
                                        Hệ thống AI nhận diện bình luận có yếu tố tiêu cực (@(Math.Round((dg.DoTinCay ?? 0) * 100, 1))%). Đánh giá đang được gửi đến Quản trị viên xem xét trước khi hiển thị công khai.
                                    </div>
                                </div>
                            }
                            else if (dg.TrangThai == TrangThaiDanhGia.TuChoi)
                            {
                                <div class="p-3 mb-3 rounded-3" style="background:#fef2f2;border:1px solid #fecaca;font-size:12.5px;color:#991b1b">
                                    <div class="d-flex align-items-center gap-2 fw-bold mb-1">
                                        <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                                        <span>Bình luận không được duyệt hiển thị</span>
                                    </div>
                                    <div style="line-height:1.45">
                                        @(string.IsNullOrEmpty(dg.LyDoTuChoi) ? "Quản trị viên đã từ chối hiển thị do nội dung chứa yếu tố tiêu cực hoặc không phù hợp." : $"Lý do: {dg.LyDoTuChoi}")
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="mb-2">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size:11.5px">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đã duyệt &amp; Hiển thị công khai
                                    </span>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="amp-label mb-1">Đánh giá của bạn:</label>
                                <div class="amp-rating mb-2">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= dg.SoSao ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                    }
                                    <span class="ms-2" style="font-size:12px;color:var(--amp-muted)">(@dg.NgayDanhGia.ToString("dd/MM/yyyy HH:mm"))</span>
                                </div>
                                <div class="p-3 rounded bg-light border" style="font-size:13.5px;color:#1f2937">
                                    @dg.NoiDung
                                </div>
                            </div>

                            <label class="amp-label mb-1">Phản hồi từ shop:</label>
                            @if (!string.IsNullOrEmpty(dg.PhanHoi))
                            {
                                <div class="p-3 rounded border" style="background:#f0fdf4;border-color:#bbf7d0!important">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong style="font-size:13px;color:#15803d"><i class="bi bi-shop me-1"></i>Thương hiệu AMP</strong>
                                        @if (dg.NgayPhanHoi.HasValue)
                                        {
                                            <span style="font-size:11.5px;color:#16a34a">@dg.NgayPhanHoi.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                    </div>
                                    <div style="font-size:13px;color:#166534;line-height:1.4">
                                        @dg.PhanHoi
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 rounded bg-light border text-muted" style="font-size:13px">
                                    <i class="bi bi-clock me-1"></i>Cửa hàng đang tiếp nhận và sẽ sớm phản hồi đánh giá của bạn. Cảm ơn bạn!
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="amp-btn amp-btn-outline" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ============ MODAL CẢNH BÁO TIÊU CỰC (AI PHOBERT) ============ -->
    <div class="modal fade" id="modalCanhBaoTieuCuc" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden">
                <div class="modal-header border-0 bg-warning bg-opacity-10 py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-exclamation fs-3 text-warning"></i>
                        <div>
                            <h5 class="modal-title fw-bold fs-6 mb-0 text-dark">Cảnh báo: Nội dung có thể tiêu cực</h5>
                            <span class="badge bg-danger text-white mt-1" id="aiWarningBadge" style="font-size:11px;font-weight:600">AI PhoBERT: Tiêu cực 99%</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="p-3 rounded-3 bg-light border mb-3" style="font-size:13px;color:#374151">
                        <div class="text-muted small mb-1"><i class="bi bi-chat-left-quote me-1"></i>Nội dung đánh giá của bạn:</div>
                        <div id="aiWarningTextPreview" class="fst-italic fw-medium text-dark"></div>
                    </div>

                    <p style="font-size:13.5px;line-height:1.6;color:#4b5563;margin-bottom:12px">
                        Hệ thống AI nhận thấy đánh giá của bạn có dấu hiệu chứa từ ngữ gay gắt hoặc phàn nàn nặng nề. Bạn có muốn <strong>kiểm tra và điều chỉnh lại</strong> nhận xét không?
                    </p>

                    <div class="alert alert-warning border-0 d-flex align-items-start gap-2 py-2 px-3 mb-0" style="background:#fffbeb;color:#92400e;font-size:12.5px;border-radius:10px">
                        <i class="bi bi-info-circle-fill fs-6 mt-1 flex-shrink-0"></i>
                        <div>
                            <strong>Lưu ý:</strong> Bạn vẫn có thể chọn <em>"Vẫn gửi đánh giá"</em>. Tuy nhiên bình luận sẽ được chuyển sang hàng chờ để <strong>Quản trị viên (Admin) xem xét duyệt</strong> trước khi hiển thị công khai.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold" style="font-size:13px" onclick="quayLaiChinhSua()">
                        <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa lại
                    </button>
                    <button type="button" class="btn btn-dark rounded-pill px-3 py-2 fw-semibold" style="font-size:13px;background:#111827" onclick="tiepTucGuiDanhGia()">
                        <i class="bi bi-send me-1"></i>Vẫn gửi đánh giá
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    let currentDangKiemTraSanPhamId = null;

    async function handleKiemTraDanhGia(event, sanPhamId) {
        const xacNhanInput = document.getElementById('xacNhanGuiTieuCuc' + sanPhamId);
        if (xacNhanInput && xacNhanInput.value === 'true') {
            return true; // Người dùng đã xác nhận vẫn gửi dù tiêu cực -> submit thẳng
        }

        event.preventDefault();
        const noiDungInput = document.getElementById('noiDung' + sanPhamId);
        const soSaoInput = document.getElementById('soSao' + sanPhamId);
        const submitBtn = document.getElementById('btnSubmitDanhGia' + sanPhamId);

        const noiDung = (noiDungInput?.value || '').trim();
        const soSao = parseInt(soSaoInput?.value || '5', 10);

        if (!noiDung) {
            alert('Vui lòng nhập nội dung đánh giá.');
            return false;
        }

        const originalBtnText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang kiểm tra AI...';

        try {
            const resp = await fetch('/DonHang/KiemTraDanhGia', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ noiDung: noiDung, soSao: soSao })
            });

            const data = await resp.json();
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;

            if (data.isNegative) {
                // Lưu ID sản phẩm đang chờ cảnh báo
                currentDangKiemTraSanPhamId = sanPhamId;

                // Ẩn modal đánh giá tạm thời
                const modalEl = document.getElementById('modalDanhGia' + sanPhamId);
                const modalBs = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modalBs.hide();

                // Cập nhật nội dung modal cảnh báo
                document.getElementById('aiWarningBadge').textContent = 'AI PhoBERT: Tiêu cực ' + data.confidence + '%';
                document.getElementById('aiWarningTextPreview').textContent = '"' + noiDung + '"';

                // Mở modal cảnh báo
                const modalCanhBao = new bootstrap.Modal(document.getElementById('modalCanhBaoTieuCuc'));
                modalCanhBao.show();
                return false;
            } else {
                // Bình thường hoặc tích cực -> submit thẳng
                xacNhanInput.value = 'true';
                document.getElementById('formDanhGia' + sanPhamId).submit();
                return true;
            }
        } catch (err) {
            console.error('Lỗi khi gọi AI kiểm tra cảm xúc:', err);
            // Nếu có lỗi mạng hoặc API chưa sẵn sàng, cho phép gửi bình thường
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
            xacNhanInput.value = 'true';
            document.getElementById('formDanhGia' + sanPhamId).submit();
            return true;
        }
    }

    function quayLaiChinhSua() {
        const modalCanhBao = bootstrap.Modal.getInstance(document.getElementById('modalCanhBaoTieuCuc'));
        if (modalCanhBao) modalCanhBao.hide();

        if (currentDangKiemTraSanPhamId) {
            const modalEl = document.getElementById('modalDanhGia' + currentDangKiemTraSanPhamId);
            const modalBs = new bootstrap.Modal(modalEl);
            modalBs.show();
            setTimeout(() => {
                const txt = document.getElementById('noiDung' + currentDangKiemTraSanPhamId);
                if (txt) txt.focus();
            }, 300);
        }
    }

    function tiepTucGuiDanhGia() {
        if (!currentDangKiemTraSanPhamId) return;

        const modalCanhBao = bootstrap.Modal.getInstance(document.getElementById('modalCanhBaoTieuCuc'));
        if (modalCanhBao) modalCanhBao.hide();

        const form = document.getElementById('formDanhGia' + currentDangKiemTraSanPhamId);
        const xacNhanInput = document.getElementById('xacNhanGuiTieuCuc' + currentDangKiemTraSanPhamId);
        if (xacNhanInput && form) {
            xacNhanInput.value = 'true';
            form.submit();
        }
    }
</script>
}
