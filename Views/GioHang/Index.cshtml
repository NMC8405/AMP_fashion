@model GioHangViewModel
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    var lienQuan = ViewBag.SanPhamLienQuan as List<SanPham> ?? new();
}

<div class="amp-container" style="padding:36px 24px 90px">
    <!-- TIÊU ĐỀ TRANG GIỎ HÀNG (FIGMA / TESTER STYLE) -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-controller="SanPham" asp-action="DanhSach" class="text-dark fs-5 text-decoration-none" title="Quay lại">
            <i class="bi bi-chevron-left"></i>
        </a>
        <h1 class="fw-bold mb-0 text-uppercase" style="font-size:20px;letter-spacing:.04em">
            GIỎ HÀNG CỦA BẠN <span class="text-muted fw-normal text-lowercase" style="font-size:14px">(<span id="labelTongLoai">@Model.DongSanPhams.Count</span> sản phẩm)</span>
        </h1>
    </div>

    @if (Model.DongSanPhams.Count == 0)
    {
        <div class="amp-empty text-center py-5">
            <i class="bi bi-bag fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-bold text-dark">Giỏ hàng của bạn đang trống</h5>
            <p class="text-muted" style="font-size:14px">Hãy khám phá bộ sưu tập thời trang AMP để chọn những món đồ ưng ý nhất.</p>
            <a asp-controller="SanPham" asp-action="DanhSach" class="amp-btn amp-btn-primary mt-2">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- CỘT TRÁI: BẢNG SẢN PHẨM VỚI CHECKBOX TÍCH CHỌN (TESTER BUG 1.4) -->
            <div class="col-lg-8">
                <div class="amp-cart-table-wrap mb-3">
                    <table class="amp-cart-table">
                        <thead>
                            <tr>
                                <th style="width:44px;text-align:center">
                                    <input type="checkbox" id="chkAll" class="amp-cart-checkbox" checked onchange="toggleSelectAll(this)" title="Chọn tất cả" />
                                </th>
                                <th>SẢN PHẨM</th>
                                <th style="width:130px;text-align:right">ĐƠN GIÁ</th>
                                <th style="width:130px;text-align:center">SỐ LƯỢNG</th>
                                <th style="width:140px;text-align:right">THÀNH TIỀN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DongSanPhams)
                            {
                                var bt = item.BienTheSanPham!;
                                var donGia = bt.SanPham?.GiaHienThi ?? 0;
                                <tr id="cartRow_@item.Id" class="cart-item-row selected">
                                    <td style="text-align:center">
                                        <input type="checkbox" class="amp-cart-checkbox cart-item-chk" 
                                               value="@item.Id" 
                                               data-id="@item.Id" 
                                               data-price="@donGia" 
                                               data-qty="@item.SoLuong" 
                                               checked 
                                               onchange="onItemCheckChange(this)" />
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <a asp-controller="SanPham" asp-action="ChiTiet" asp-route-id="@bt.SanPhamId">
                                                <img src="@(bt.SanPham?.HinhAnhChinh ?? "/images/placeholder.jpg")" 
                                                     alt="@bt.SanPham?.TenSanPham" 
                                                     class="amp-prod-thumb" 
                                                     style="width:68px;height:82px;object-fit:cover;border-radius:6px;border:1px solid #E5E7EB" />
                                            </a>
                                            <div class="amp-cart-item-meta">
                                                <span class="cat">@(bt.SanPham?.DanhMuc?.TenDanhMuc ?? "AMP Fashion")</span>
                                                <a asp-controller="SanPham" asp-action="ChiTiet" asp-route-id="@bt.SanPhamId" class="name">
                                                    @(bt.SanPham?.TenSanPham ?? "Sản phẩm")
                                                </a>
                                                <div class="variant">
                                                    <span class="amp-swatch" style="background:@(bt.MauSac?.MaHex ?? "#000");width:12px;height:12px;border-radius:50%;display:inline-block;border:1px solid #D1D5DB"></span>
                                                    <span>@(bt.MauSac?.TenMau ?? "")</span>
                                                    <span>·</span>
                                                    <span>Size: <strong>@(bt.KichThuoc?.TenKichThuoc ?? "")</strong></span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="text-align:right;font-weight:600;font-size:13.5px;color:#374151">
                                        @donGia.ToString("N0")₫
                                    </td>
                                    <td style="text-align:center">
                                        <form asp-controller="GioHang" asp-action="CapNhat" method="post" class="d-inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="GioHangItemId" value="@item.Id" />
                                            <div class="amp-qty-box" data-auto-submit style="height:34px">
                                                <button type="button" data-qty-minus style="width:28px;height:32px">−</button>
                                                <input type="number" name="SoLuong" value="@item.SoLuong" min="1" max="@bt.SoLuongTon" style="width:40px;height:32px;font-size:13px" />
                                                <button type="button" data-qty-plus style="width:28px;height:32px">+</button>
                                            </div>
                                        </form>
                                    </td>
                                    <td style="text-align:right;font-weight:700;font-size:14px;color:#111827">
                                        @item.ThanhTien.ToString("N0")₫
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- THAO TÁC XÓA SẢN PHẨM & TIẾP TỤC MUA SẮM (FIGMA TESTER STYLE) -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                    <button type="button" id="btnXoaDaChon" class="amp-btn amp-btn-outline" 
                            style="border-color:#DC2626;color:#DC2626;font-size:13px;padding:9px 20px" 
                            onclick="xoaCacMonDaChon()">
                        XÓA SẢN PHẨM
                    </button>

                    <a asp-controller="SanPham" asp-action="DanhSach" class="amp-btn amp-btn-outline" style="font-size:13px;padding:9px 20px">
                        TIẾP TỤC MUA SẮM
                    </a>
                </div>

                <!-- FORM ẨN ĐỂ XÓA CÁC SẢN PHẨM ĐƯỢC CHỌN -->
                <form id="formXoaChon" asp-controller="GioHang" asp-action="XoaCacSanPham" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <div id="wrapInputsXoaChon"></div>
                </form>
            </div>

            <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG & MÃ GIẢM GIÁ (FIGMA / TESTER BUG 1.4) -->
            <div class="col-lg-4">
                <div class="amp-summary-box shadow-sm" style="background:#FFFFFF;border:1px solid #E5E7EB;border-radius:8px;padding:24px">
                    <h2 class="amp-heading-sm mb-3 text-uppercase fw-bold" style="font-size:15px;letter-spacing:.04em">TÓM TẮT ĐƠN HÀNG</h2>

                    <!-- KHỐI MÃ GIẢM GIÁ VOUCHER -->
                    <div class="mb-3">
                        <div class="input-group">
                            <input type="text" id="inpVoucher" class="form-control" placeholder="Mã giảm giá (ví dụ: SUMMER25)..." 
                                   style="text-transform:uppercase;font-size:13px;font-weight:600" />
                            <button type="button" id="btnApDungVoucher" class="btn btn-dark fw-bold px-3" style="font-size:13px" onclick="apDungVoucher()">
                                Áp dụng
                            </button>
                        </div>
                        <div id="voucherMsg" class="mt-1" style="font-size:12px"></div>

                        <!-- BADGE HIỂN THỊ VOUCHER ĐÃ ÁP DỤNG -->
                        <div id="voucherBadge" class="amp-voucher-badge d-none">
                            <div>
                                <div class="fw-bold" id="badgeMaVoucher"></div>
                                <div id="badgeMoTaVoucher" style="font-size:11.5px"></div>
                            </div>
                            <a href="javascript:void(0)" onclick="goVoucher()" class="text-danger fw-bold text-decoration-none" style="font-size:12px">
                                Gỡ
                            </a>
                        </div>
                    </div>

                    <!-- CÁC DÒNG TÍNH TOÁN DỰA TRÊN CÁC SẢN PHẨM ĐƯỢC TÍCH CHỌN -->
                    <div class="amp-summary-row" style="font-size:13.5px;padding:9px 0">
                        <span>Tạm tính (<span id="txtCountSelected">@Model.DongSanPhams.Count</span> sản phẩm)</span>
                        <span id="txtTamTinh" class="fw-bold text-dark">@Model.TongTien.ToString("N0")₫</span>
                    </div>

                    <div class="amp-summary-row" id="rowKhuyenMai" style="font-size:13.5px;padding:9px 0">
                        <span>Khuyến mãi</span>
                        <span id="txtKhuyenMai" class="fw-bold text-success">-0₫</span>
                    </div>

                    <div class="amp-summary-row" style="font-size:13.5px;padding:9px 0">
                        <span>Phí vận chuyển</span>
                        <span id="txtPhiShip" class="fw-semibold text-dark">
                            @(Model.TongTien >= 500000 ? "Miễn phí" : "30.000₫")
                        </span>
                    </div>

                    <hr class="my-2" style="border-color:#E5E7EB" />

                    <div class="amp-summary-row total pt-2" style="font-size:16px;font-weight:800;color:#111827">
                        <span>Tổng thanh toán</span>
                        <span id="txtTongThanhToan" style="font-size:19px;color:#111827">
                            @((Model.TongTien + (Model.TongTien >= 500000 || Model.TongTien == 0 ? 0 : 30000)).ToString("N0"))₫
                        </span>
                    </div>

                    <!-- FORM THANH TOÁN NGAY (CHỈ GỬI CÁC SẢN PHẨM ĐƯỢC CHỌN) -->
                    <form id="formCheckout" asp-controller="DonHang" asp-action="BatDauThanhToan" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <div id="checkoutSelectedInputs"></div>
                        <input type="hidden" name="maGiamGia" id="inpMaGiamGiaCheckout" value="" />
                        <button type="submit" id="btnThanhToanNgay" class="amp-btn amp-btn-primary amp-btn-block py-3 fw-bold text-uppercase" style="font-size:14px;letter-spacing:.04em">
                            THANH TOÁN NGAY
                        </button>
                    </form>

                    <p style="font-size:12px;color:var(--amp-muted);text-align:center;margin-top:16px;margin-bottom:0">
                        <i class="bi bi-shield-check me-1"></i>Thanh toán an toàn &amp; bảo mật tuyệt đối
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- SẢN PHẨM LIÊN QUAN -->
    @if (lienQuan.Count > 0)
    {
        <div class="mt-5 pt-5" style="border-top:1px solid #E5E7EB">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-uppercase" style="font-size:18px;letter-spacing:.06em">SẢN PHẨM LIÊN QUAN</h2>
                <p class="text-muted" style="font-size:13px">Hoàn thiện phong cách cá nhân tinh tế cùng những gợi ý đặc tuyển</p>
            </div>
            <div class="amp-product-grid">
                @foreach (var sp in lienQuan)
                {
                    <partial name="_ProductCard" model="sp" />
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    let voucherHienTai = null;

    function formatVND(n) {
        return new Intl.NumberFormat('vi-VN').format(n) + '₫';
    }

    function onItemCheckChange(chk) {
        const id = chk.getAttribute('data-id');
        const row = document.getElementById('cartRow_' + id);
        if (row) {
            if (chk.checked) row.classList.add('selected');
            else row.classList.remove('selected');
        }

        // Cập nhật trạng thái checkbox Chọn tất cả
        const all = document.querySelectorAll('.cart-item-chk');
        const checked = document.querySelectorAll('.cart-item-chk:checked');
        const chkAll = document.getElementById('chkAll');
        if (chkAll) chkAll.checked = (all.length > 0 && all.length === checked.length);

        tinhToanLai();
    }

    function toggleSelectAll(chkAll) {
        const isChecked = chkAll.checked;
        document.querySelectorAll('.cart-item-chk').forEach(chk => {
            chk.checked = isChecked;
            const id = chk.getAttribute('data-id');
            const row = document.getElementById('cartRow_' + id);
            if (row) {
                if (isChecked) row.classList.add('selected');
                else row.classList.remove('selected');
            }
        });
        tinhToanLai();
    }

    function tinhToanLai() {
        const checked = document.querySelectorAll('.cart-item-chk:checked');
        let count = checked.length;
        let tamTinh = 0;

        checked.forEach(chk => {
            const price = parseFloat(chk.getAttribute('data-price')) || 0;
            const qty = parseInt(chk.getAttribute('data-qty')) || 1;
            tamTinh += (price * qty);
        });

        // Phí vận chuyển: miễn phí khi >= 500k hoặc giỏ trống, ngược lại 30.000đ
        let phiShip = (tamTinh >= 500000 || count === 0) ? 0 : 30000;

        // Tính tiền giảm voucher
        let soTienGiam = 0;
        if (voucherHienTai && count > 0) {
            if (tamTinh >= voucherHienTai.giaTriDonHangToiThieu) {
                if (voucherHienTai.loaiGiamGia === 'PhanTram') {
                    soTienGiam = (tamTinh * voucherHienTai.giaTriGiam) / 100;
                    if (voucherHienTai.giaTriGiamToiDa > 0 && soTienGiam > voucherHienTai.giaTriGiamToiDa) {
                        soTienGiam = voucherHienTai.giaTriGiamToiDa;
                    }
                } else {
                    soTienGiam = voucherHienTai.giaTriGiam;
                }
            } else {
                // Đơn hàng chưa đạt mức tối thiểu
                soTienGiam = 0;
            }
        }

        let tongThanhToan = Math.max(0, tamTinh + phiShip - soTienGiam);

        // Hiển thị ra UI
        const txtCountSelected = document.getElementById('txtCountSelected');
        if (txtCountSelected) txtCountSelected.textContent = count;

        const txtTamTinh = document.getElementById('txtTamTinh');
        if (txtTamTinh) txtTamTinh.textContent = formatVND(tamTinh);

        const txtPhiShip = document.getElementById('txtPhiShip');
        if (txtPhiShip) txtPhiShip.textContent = phiShip === 0 ? 'Miễn phí' : formatVND(phiShip);

        const txtKhuyenMai = document.getElementById('txtKhuyenMai');
        if (txtKhuyenMai) txtKhuyenMai.textContent = '-' + formatVND(soTienGiam);

        const txtTongThanhToan = document.getElementById('txtTongThanhToan');
        if (txtTongThanhToan) txtTongThanhToan.textContent = formatVND(tongThanhToan);

        // Nút bấm trạng thái
        const btnThanhToan = document.getElementById('btnThanhToanNgay');
        const btnXoa = document.getElementById('btnXoaDaChon');
        if (btnThanhToan) {
            btnThanhToan.disabled = (count === 0);
            btnThanhToan.style.opacity = (count === 0) ? '0.5' : '1';
        }
        if (btnXoa) {
            btnXoa.disabled = (count === 0);
            btnXoa.style.opacity = (count === 0) ? '0.5' : '1';
        }

        // Cập nhật các hidden inputs cho Checkout Form
        const inputsWrap = document.getElementById('checkoutSelectedInputs');
        if (inputsWrap) {
            inputsWrap.innerHTML = '';
            checked.forEach(chk => {
                const hiddenInp = document.createElement('input');
                hiddenInp.type = 'hidden';
                hiddenInp.name = 'selectedItemIds';
                hiddenInp.value = chk.value;
                inputsWrap.appendChild(hiddenInp);
            });
        }
    }

    async function apDungVoucher() {
        const inp = document.getElementById('inpVoucher');
        const msg = document.getElementById('voucherMsg');
        const ma = inp ? inp.value.trim() : '';

        if (!ma) {
            if (msg) {
                msg.textContent = 'Vui lòng nhập mã giảm giá.';
                msg.className = 'mt-1 text-danger';
            }
            return;
        }

        // Lấy tạm tính hiện tại của các sản phẩm được chọn
        const checked = document.querySelectorAll('.cart-item-chk:checked');
        let tamTinh = 0;
        checked.forEach(chk => {
            const price = parseFloat(chk.getAttribute('data-price')) || 0;
            const qty = parseInt(chk.getAttribute('data-qty')) || 1;
            tamTinh += (price * qty);
        });

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('ma', ma);
            formData.append('tamTinh', tamTinh);
            formData.append('__RequestVerificationToken', token);

            const res = await fetch('/GioHang/KiemTraVoucher', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            if (data.hopLe) {
                voucherHienTai = {
                    ma: data.ma,
                    soTienGiam: data.soTienGiam,
                    moTa: data.moTa,
                    giaTriDonHangToiThieu: 0,
                    loaiGiamGia: 'CoDinh',
                    giaTriGiam: data.soTienGiam
                };

                // Hiển thị badge
                const badge = document.getElementById('voucherBadge');
                const badgeMa = document.getElementById('badgeMaVoucher');
                const badgeMoTa = document.getElementById('badgeMoTaVoucher');
                const inpCheckout = document.getElementById('inpMaGiamGiaCheckout');

                if (badge) badge.classList.remove('d-none');
                if (badgeMa) badgeMa.textContent = data.ma;
                if (badgeMoTa) badgeMoTa.textContent = data.moTa;
                if (inpCheckout) inpCheckout.value = data.ma;
                if (msg) msg.textContent = '';

                tinhToanLai();
            } else {
                if (msg) {
                    msg.textContent = data.thongBao;
                    msg.className = 'mt-1 text-danger';
                }
            }
        } catch (e) {
            console.error(e);
        }
    }

    function goVoucher() {
        voucherHienTai = null;
        const badge = document.getElementById('voucherBadge');
        const inpCheckout = document.getElementById('inpMaGiamGiaCheckout');
        const inp = document.getElementById('inpVoucher');
        const msg = document.getElementById('voucherMsg');

        if (badge) badge.classList.add('d-none');
        if (inpCheckout) inpCheckout.value = '';
        if (inp) inp.value = '';
        if (msg) msg.textContent = '';

        tinhToanLai();
    }

    function xoaCacMonDaChon() {
        const checked = document.querySelectorAll('.cart-item-chk:checked');
        if (checked.length === 0) {
            alert('Vui lòng chọn ít nhất một sản phẩm cần xóa.');
            return;
        }

        if (!confirm(`Bạn có chắc muốn xóa ${checked.length} sản phẩm đã chọn khỏi giỏ hàng?`)) {
            return;
        }

        const form = document.getElementById('formXoaChon');
        const wrap = document.getElementById('wrapInputsXoaChon');
        if (form && wrap) {
            wrap.innerHTML = '';
            checked.forEach(chk => {
                const inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'selectedItemIds';
                inp.value = chk.value;
                wrap.appendChild(inp);
            });
            form.submit();
        }
    }

    // Khởi tạo tính toán khi tải trang
    document.addEventListener('DOMContentLoaded', () => {
        tinhToanLai();
    });
</script>
}

