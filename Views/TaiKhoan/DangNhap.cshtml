@model DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}
<div class="amp-auth-wrap">
    <div class="amp-auth-card">
        <h1>Đăng nhập</h1>
        <p class="amp-sub">Chào mừng bạn trở lại với AMP Fashion</p>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-action="DangNhap" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="amp-field">
                <label asp-for="Email" class="amp-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Nhập email của bạn" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="amp-field">
                <label asp-for="MatKhau" class="amp-label"></label>
                <div class="amp-input-password-wrap">
                    <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu" />
                    <button type="button" class="amp-btn-eye" aria-label="Hiện/ẩn mật khẩu" tabindex="-1"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>
            <div class="amp-auth-links">
                <div class="form-check">
                    <input asp-for="GhiNho" class="form-check-input" id="ghiNho" />
                    <label asp-for="GhiNho" class="form-check-label" for="ghiNho">Ghi nhớ đăng nhập</label>
                </div>
                <a asp-action="QuenMatKhau" class="amp-link">Quên mật khẩu?</a>
            </div>
            <button type="submit" class="amp-btn amp-btn-primary amp-btn-block">Đăng nhập</button>
        </form>

        <p class="amp-auth-foot">Chưa có tài khoản? <a asp-action="DangKy" class="amp-link">Đăng ký ngay</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
