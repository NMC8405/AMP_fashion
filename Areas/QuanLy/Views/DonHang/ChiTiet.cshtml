@model DonHang
@{
    ViewData["Title"] = "Đơn hàng " + Model.MaDonHang;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="amp-table-card mb-3" style="padding:24px">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="mb-1">@Model.MaDonHang</h5>
                    <span style="font-size:12.5px;color:var(--amp-muted)">Đặt lúc @Model.NgayDat.ToString("HH:mm dd/MM/yyyy")</span>
                </div>
                <span class="amp-status amp-status-@Model.CssTrangThai" style="font-size:13px">@Model.TenTrangThai</span>
            </div>

            @if (Model.TrangThaiDonHang == TrangThaiDonHang.DaHuy && !string.IsNullOrEmpty(Model.LyDoHuy))
            {
                <div class="amp-alert amp-alert-danger">Lý do hủy: @Model.LyDoHuy</div>
            }

            <table class="amp-table" style="margin-top:10px">
                <thead><tr><th>Sản phẩm</th><th>Màu / Size</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
                <tbody>
                    @foreach (var ct in Model.ChiTietDonHangs)
                    {
                        <tr>
                            <td class="d-flex align-items-center gap-2"><img src="@ct.HinhAnh" class="amp-thumb-sm" />@ct.TenSanPham</td>
                            <td>@ct.TenMau / @ct.TenKichThuoc</td>
                            <td>@ct.SoLuong</td>
                            <td>@ct.DonGia.ToString("N0")₫</td>
                            <td>@ct.ThanhTien.ToString("N0")₫</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="amp-summary-row"><span>Tạm tính</span><span>@Model.TamTinh.ToString("N0")₫</span></div>
            <div class="amp-summary-row"><span>Phí vận chuyển</span><span>@Model.PhiVanChuyen.ToString("N0")₫</span></div>
            @if (Model.SoTienGiamGia > 0)
            {
                <div class="amp-summary-row"><span>Giảm giá @(Model.MaGiamGiaApDung != null ? $"({Model.MaGiamGiaApDung.Ma})" : "")</span><span class="neg">-@Model.SoTienGiamGia.ToString("N0")₫</span></div>
            }
            <div class="amp-summary-row total"><span>Tổng thanh toán</span><span>@Model.TongTien.ToString("N0")₫</span></div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="amp-table-card mb-3" style="padding:24px">
            <h6 class="amp-heading-sm mb-3">Khách hàng</h6>
            <div class="amp-summary-row"><span>Họ tên</span><span>@Model.NguoiDung?.HoTen</span></div>
            <div class="amp-summary-row"><span>Email</span><span style="font-size:12px">@Model.NguoiDung?.Email</span></div>
            <div class="amp-summary-row"><span>SĐT nhận</span><span>@Model.SoDienThoaiNhan</span></div>
            <div class="amp-summary-row"><span>Địa chỉ</span><span style="max-width:60%;text-align:right">@Model.DiaChiNhan</span></div>
            @if (!string.IsNullOrEmpty(Model.GhiChu))
            {
                <div class="amp-summary-row"><span>Ghi chú</span><span>@Model.GhiChu</span></div>
            }
            <div class="amp-summary-row"><span>Thanh toán</span><span>@(Model.PhuongThucThanhToan == PhuongThucThanhToan.ThanhToanKhiNhanHang ? "COD" : "Chuyển khoản")</span></div>
        </div>

        <div class="amp-table-card" style="padding:24px">
            <h6 class="amp-heading-sm mb-3">Xử lý đơn hàng</h6>
            <div class="d-flex flex-column gap-2">
                @if (Model.TrangThaiDonHang == TrangThaiDonHang.ChoThanhToan)
                {
                    <form asp-action="XacNhanThanhToan" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="amp-btn amp-btn-primary amp-btn-block">Xác nhận đã thanh toán</button>
                    </form>
                }
                @if (Model.TrangThaiDonHang == TrangThaiDonHang.ChoXacNhan)
                {
                    <form asp-action="XacNhanDon" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="amp-btn amp-btn-primary amp-btn-block">Xác nhận đơn hàng</button>
                    </form>
                }
                @if (Model.TrangThaiDonHang == TrangThaiDonHang.DaXacNhan)
                {
                    <form asp-action="GiaoVanChuyen" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="amp-btn amp-btn-primary amp-btn-block">Bàn giao vận chuyển</button>
                    </form>
                }
                @if (Model.TrangThaiDonHang == TrangThaiDonHang.DangGiao)
                {
                    <p style="font-size:12.5px;color:var(--amp-muted);margin:0">Đang chờ khách hàng xác nhận đã nhận được hàng.</p>
                }
                @if (Model.TrangThaiDonHang is TrangThaiDonHang.ChoThanhToan or TrangThaiDonHang.ChoXacNhan or TrangThaiDonHang.DaXacNhan)
                {
                    <button type="button" class="amp-btn amp-btn-danger amp-btn-block" data-bs-toggle="modal" data-bs-target="#modalHuy">Hủy đơn hàng</button>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalHuy" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Huy" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header"><h5 class="modal-title">Hủy đơn hàng</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <label class="amp-label">Lý do hủy</label>
                    <textarea name="lyDoHuy" class="form-control" rows="3" placeholder="Nhập lý do hủy đơn..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="amp-btn amp-btn-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="amp-btn amp-btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>
