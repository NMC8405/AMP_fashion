@model List<DonHang>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    string trangThaiHienTai = ViewBag.TrangThaiHienTai ?? "";
    var dem = ViewBag.DemTheoTrangThai as Dictionary<TrangThaiDonHang, int> ?? new();
    int Dem(TrangThaiDonHang t) => dem.TryGetValue(t, out var v) ? v : 0;
}
<div class="amp-tabs">
    <a asp-action="DanhSach" class="@(trangThaiHienTai == "" ? "active" : "")">Tất cả</a>
    <a asp-action="DanhSach" asp-route-trangThai="ChoThanhToan" class="@(trangThaiHienTai == "ChoThanhToan" ? "active" : "")">Chờ thanh toán <span class="badge-count">@Dem(TrangThaiDonHang.ChoThanhToan)</span></a>
    <a asp-action="DanhSach" asp-route-trangThai="ChoXacNhan" class="@(trangThaiHienTai == "ChoXacNhan" ? "active" : "")">Chờ xác nhận <span class="badge-count">@Dem(TrangThaiDonHang.ChoXacNhan)</span></a>
    <a asp-action="DanhSach" asp-route-trangThai="DaXacNhan" class="@(trangThaiHienTai == "DaXacNhan" ? "active" : "")">Đã xác nhận <span class="badge-count">@Dem(TrangThaiDonHang.DaXacNhan)</span></a>
    <a asp-action="DanhSach" asp-route-trangThai="DangGiao" class="@(trangThaiHienTai == "DangGiao" ? "active" : "")">Đang giao <span class="badge-count">@Dem(TrangThaiDonHang.DangGiao)</span></a>
    <a asp-action="DanhSach" asp-route-trangThai="DaGiao" class="@(trangThaiHienTai == "DaGiao" ? "active" : "")">Đã giao <span class="badge-count">@Dem(TrangThaiDonHang.DaGiao)</span></a>
    <a asp-action="DanhSach" asp-route-trangThai="DaHuy" class="@(trangThaiHienTai == "DaHuy" ? "active" : "")">Đã hủy <span class="badge-count">@Dem(TrangThaiDonHang.DaHuy)</span></a>
</div>

<div class="amp-table-toolbar">
    <form method="get" class="d-flex gap-2">
        <input type="hidden" name="trangThai" value="@trangThaiHienTai" />
        <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm theo mã đơn, tên, SĐT..." style="width:280px" />
        <button type="submit" class="amp-btn amp-btn-outline">Tìm</button>
    </form>
    <span class="count" style="font-size:13px;color:var(--amp-muted)">@ViewBag.TongSo đơn hàng</span>
</div>

<div class="amp-table-card">
    <table class="amp-table">
        <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Không có đơn hàng nào.</td></tr>
            }
            @foreach (var d in Model)
            {
                <tr>
                    <td><strong>@d.MaDonHang</strong></td>
                    <td>@d.TenNguoiNhan<div style="font-size:11.5px;color:var(--amp-muted)">@d.SoDienThoaiNhan</div></td>
                    <td style="font-size:12.5px">@d.NgayDat.ToString("dd/MM/yy HH:mm")</td>
                    <td>@d.TongTien.ToString("N0")₫</td>
                    <td style="font-size:12.5px">@(d.TrangThaiThanhToan == TrangThaiThanhToan.DaThanhToan ? "Đã thanh toán" : d.TrangThaiThanhToan == TrangThaiThanhToan.DaHoanTien ? "Đã hoàn tiền" : "Chưa thanh toán")</td>
                    <td><span class="amp-status amp-status-@d.CssTrangThai">@d.TenTrangThai</span></td>
                    <td><a asp-action="ChiTiet" asp-route-id="@d.Id" class="amp-btn amp-btn-outline amp-btn-sm">Xem</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{ int trang = ViewBag.Trang; int tongTrang = ViewBag.TongTrang; }
@if (tongTrang > 1)
{
    <div class="amp-pagination">
        @for (int i = 1; i <= tongTrang; i++)
        {
            <a href="@Url.Action("DanhSach", new { trangThai = trangThaiHienTai, tuKhoa = ViewBag.TuKhoa, trang = i })" class="@(i == trang ? "active" : "")">@i</a>
        }
    </div>
}
