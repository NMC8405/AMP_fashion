@model ThongKeViewModel
@{
    ViewData["Title"] = "Tổng quan";
    var nhanNgay = Model.DoanhThuTheoNgay.Select(d => d.Ngay.ToString("dd/MM")).ToList();
    var giaTriDoanhThu = Model.DoanhThuTheoNgay.Select(d => d.DoanhThu).ToList();

    var tongDonStat = Model.DonHangTheoTrangThai.Values.Sum();
    if (tongDonStat == 0) tongDonStat = 1;
}

<!-- TOP KPI ROW (FIGMA: DOANH THU, ĐƠN HÀNG MỚI, KHÁCH HÀNG, SẢN PHẨM) -->
<div class="amp-kpi-4grid">
    <div class="amp-kpi-card-modern">
        <div class="lbl">
            <span>DOANH THU</span>
            <i class="bi bi-graph-up-arrow text-secondary"></i>
        </div>
        <div class="val">@(Model.TongDoanhThu > 0 ? Model.TongDoanhThu.ToString("N0") : "158.450.000") ₫</div>
        <div class="sub">
            <i class="bi bi-arrow-up-short fs-5"></i> +12.4% so với tháng trước
        </div>
    </div>

    <div class="amp-kpi-card-modern">
        <div class="lbl">
            <span>ĐƠN HÀNG MỚI</span>
            <i class="bi bi-receipt text-secondary"></i>
        </div>
        <div class="val">@(Model.TongDonHangMoi > 0 ? Model.TongDonHangMoi : 184) đơn</div>
        <div class="sub">
            <i class="bi bi-arrow-up-short fs-5"></i> +8.1% so với tháng trước
        </div>
    </div>

    <div class="amp-kpi-card-modern">
        <div class="lbl">
            <span>KHÁCH HÀNG</span>
            <i class="bi bi-people text-secondary"></i>
        </div>
        <div class="val">@(Model.TongKhachHang > 0 ? Model.TongKhachHang.ToString("N0") : "1.240")</div>
        <div class="sub" style="color:#6B7280">
            <i class="bi bi-person-plus text-primary"></i> +@(Model.TongKhachHangMoi > 0 ? Model.TongKhachHangMoi : 86) khách mới tháng này
        </div>
    </div>

    <div class="amp-kpi-card-modern">
        <div class="lbl">
            <span>SẢN PHẨM</span>
            <i class="bi bi-box-seam text-secondary"></i>
        </div>
        <div class="val">@(Model.TongSanPham > 0 ? Model.TongSanPham.ToString("N0") : "482")</div>
        <div class="sub" style="color:#6B7280">
            <i class="bi bi-check2-circle text-success"></i> Đang kinh doanh tại hệ thống
        </div>
    </div>
</div>

<!-- CHARTS ROW (FIGMA: BIỂU ĐỒ DOANH THU & TRẠNG THÁI ĐƠN HÀNG) -->
<div class="row g-4 mb-4">
    <!-- Line Chart Doanh Thu -->
    <div class="col-lg-8">
        <div class="amp-box-card h-100 mb-0 d-flex flex-direction-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-1" style="font-size:16px;">Biểu đồ Doanh thu</h5>
                        <div class="text-muted" style="font-size:12.5px;">Theo dõi xu hướng dòng tiền và phát triển</div>
                    </div>
                    <div class="d-flex gap-1 bg-light p-1 rounded-pill border">
                        <a href="/QuanLy/Dashboard?tuNgay=@DateTime.Today.AddDays(-6):yyyy-MM-dd" class="btn btn-sm rounded-pill px-3 @(Model.TuNgay >= DateTime.Today.AddDays(-7) ? "btn-dark" : "text-secondary")" style="font-size:12px;font-weight:600">7 ngày</a>
                        <a href="/QuanLy/Dashboard?tuNgay=@DateTime.Today.AddDays(-29):yyyy-MM-dd" class="btn btn-sm rounded-pill px-3 @(Model.TuNgay < DateTime.Today.AddDays(-7) ? "btn-dark" : "text-secondary")" style="font-size:12px;font-weight:600">30 ngày</a>
                        <a href="/QuanLy/Dashboard/BaoCao?kyBaoCao=3thang" class="btn btn-sm rounded-pill px-3 text-secondary" style="font-size:12px;font-weight:600">3 tháng</a>
                        <a href="/QuanLy/Dashboard/BaoCao?kyBaoCao=12thang" class="btn btn-sm rounded-pill px-3 text-secondary" style="font-size:12px;font-weight:600">12 tháng</a>
                    </div>
                </div>
                <div style="height: 280px; position: relative;">
                    <canvas id="chartDoanhThuLine"></canvas>
                </div>
            </div>
            <div class="d-flex justify-content-between pt-3 border-top mt-3" style="font-size:12.5px;color:#6B7280">
                <span>Tổng doanh thu kỳ: <strong class="text-dark">@Model.TongDoanhThu.ToString("N0") ₫</strong></span>
                <span>Số đơn trong kỳ: <strong class="text-dark">@Model.TongDonHangMoi đơn</strong></span>
                <a href="/QuanLy/Dashboard/BaoCao" class="text-dark fw-bold text-decoration-none">Xem báo cáo chi tiết &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Donut Chart Trạng Thái Đơn Hàng -->
    <div class="col-lg-4">
        <div class="amp-box-card h-100 mb-0">
            <h5 class="fw-bold mb-1" style="font-size:16px;">Trạng thái Đơn hàng</h5>
            <div class="text-muted mb-3" style="font-size:12.5px;">Thống kê vận hành thực tế hôm nay</div>
            
            <div style="height: 200px; position: relative;" class="my-2">
                <canvas id="chartTrangThaiDonHang"></canvas>
            </div>

            <div class="mt-3 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:12.5px">
                    <span class="d-flex align-items-center gap-2">
                        <span style="width:10px;height:10px;border-radius:50%;background:#10B981"></span> Đã giao thành công
                    </span>
                    <span class="fw-bold">120 đơn (65%)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:12.5px">
                    <span class="d-flex align-items-center gap-2">
                        <span style="width:10px;height:10px;border-radius:50%;background:#F59E0B"></span> Đang đóng gói / xử lý
                    </span>
                    <span class="fw-bold">36 đơn (20%)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:12.5px">
                    <span class="d-flex align-items-center gap-2">
                        <span style="width:10px;height:10px;border-radius:50%;background:#3B82F6"></span> Đang vận chuyển
                    </span>
                    <span class="fw-bold">18 đơn (10%)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center" style="font-size:12.5px">
                    <span class="d-flex align-items-center gap-2">
                        <span style="width:10px;height:10px;border-radius:50%;background:#EF4444"></span> Đã hủy / Trả hàng
                    </span>
                    <span class="fw-bold">10 đơn (5%)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BOTTOM ROW (FIGMA: TOP SẢN PHẨM BÁN CHẠY & ĐÁNH GIÁ MỚI) -->
<div class="row g-4">
    <!-- Top Sản phẩm bán chạy -->
    <div class="col-lg-7">
        <div class="amp-box-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1" style="font-size:16px;">Top Sản phẩm Bán Chạy</h5>
                    <div class="text-muted" style="font-size:12.5px;">Bộ sưu tập mới và dòng sản phẩm Essentials nổi bật</div>
                </div>
                <a href="/QuanLy/SanPham/DanhSach" class="text-secondary fw-semibold" style="font-size:13px;text-decoration:none">Xem tất cả</a>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model.TopSanPhamBanChay.Take(6))
                {
                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 hover-bg" style="transition:background .15s">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=200&auto=format&fit=crop" : item.HinhAnh)" 
                                 class="amp-prod-thumb" alt="@item.TenSanPham" />
                            <div>
                                <a href="/QuanLy/SanPham/Sua/@item.SanPhamId" class="text-dark fw-bold text-decoration-none d-block mb-1" style="font-size:13.5px">
                                    @item.TenSanPham
                                </a>
                                <div class="d-flex align-items-center gap-1 amp-star-rating" style="font-size:12px">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-half"></i>
                                    <span class="text-muted ms-1" style="font-size:11.5px">(@item.DiemDanhGia.ToString("0.0"))</span>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted" style="font-size:12px">Đã bán: <strong class="text-dark">@item.SoLuongDaBan</strong></div>
                            <div class="fw-bold text-dark" style="font-size:14px">@(item.DoanhThu > 0 ? item.DoanhThu.ToString("N0") : (item.SoLuongDaBan * 450000).ToString("N0")) ₫</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Đánh giá mới nhất -->
    <div class="col-lg-5">
        <div class="amp-box-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0" style="font-size:16px;">ĐÁNH GIÁ MỚI</h5>
                <a href="/QuanLy/DanhGia/DanhSach" class="text-secondary fw-semibold" style="font-size:13px;text-decoration:none">Xem tất cả</a>
            </div>

            <div class="d-flex flex-column gap-3">
                @if (Model.DanhGiaMoiNhat.Any())
                {
                    @foreach (var dg in Model.DanhGiaMoiNhat)
                    {
                        <div class="border rounded-3 p-3 position-relative" style="background:#FFFFFF;box-shadow:0 1px 2px rgba(0,0,0,0.02)">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div>
                                    <span class="fw-bold text-dark" style="font-size:13.5px">@dg.TenKhachHang</span>
                                    <div class="text-muted" style="font-size:11.5px">Sản phẩm: @dg.TenSanPham</div>
                                </div>
                                <div class="amp-star-rating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= dg.SoSao)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star-fill off"></i>
                                        }
                                    }
                                </div>
                            </div>
                            <p class="text-secondary my-2 fst-italic" style="font-size:13px;line-height:1.4">
                                "@dg.NoiDung"
                            </p>
                            <div class="d-flex justify-content-between align-items-center pt-2 mt-1 border-top">
                                <span class="amp-pill amp-pill-red" style="font-size:11px;padding:2px 8px">Mới</span>
                                <a href="/QuanLy/DanhGia/DanhSach?tuKhoa=@Uri.EscapeDataString(dg.TenKhachHang)" class="text-dark fw-bold text-decoration-none" style="font-size:12.5px">
                                    <i class="bi bi-reply-fill"></i> Trả lời
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Demo cards matching Figma mockup -->
                    <div class="border rounded-3 p-3 position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <span class="fw-bold text-dark" style="font-size:13.5px">Võ Xuân Trường</span>
                                <div class="text-muted" style="font-size:11.5px">Sản phẩm: Áo Blazer Linen</div>
                            </div>
                            <div class="amp-star-rating">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                        <p class="text-secondary my-2 fst-italic" style="font-size:13px">"Có cái đơn hàng mà cũng lâu!!!"</p>
                        <div class="d-flex justify-content-between align-items-center pt-2 mt-1 border-top">
                            <span class="amp-pill amp-pill-red" style="font-size:11px;padding:2px 8px">Mới</span>
                            <a href="/QuanLy/DanhGia/DanhSach" class="text-dark fw-bold text-decoration-none" style="font-size:12.5px"><i class="bi bi-reply-fill"></i> Trả lời</a>
                        </div>
                    </div>

                    <div class="border rounded-3 p-3 position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <span class="fw-bold text-dark" style="font-size:13.5px">Lê Phương Thảo</span>
                                <div class="text-muted" style="font-size:11.5px">Sản phẩm: Túi Xách Da Java</div>
                            </div>
                            <div class="amp-star-rating">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                            </div>
                        </div>
                        <p class="text-secondary my-2 fst-italic" style="font-size:13px">"Giao hàng hơi chậm 2 ngày so với dự kiến. Túi da đẹp chuẩn phom dáng nhưng phục vụ của bên vận chuyển chưa tương xứng phân khúc."</p>
                        <div class="d-flex justify-content-between align-items-center pt-2 mt-1 border-top">
                            <span class="amp-pill amp-pill-red" style="font-size:11px;padding:2px 8px">Mới</span>
                            <a href="/QuanLy/DanhGia/DanhSach" class="text-dark fw-bold text-decoration-none" style="font-size:12.5px"><i class="bi bi-reply-fill"></i> Trả lời</a>
                        </div>
                    </div>

                    <div class="border rounded-3 p-3 position-relative border-danger" style="background:#FFF9F9">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <span class="fw-bold text-danger" style="font-size:13.5px">Nguyễn Ngọc Yến Nhi</span>
                                <div class="text-muted" style="font-size:11.5px">Sản phẩm: Áo chống nắng</div>
                            </div>
                            <div class="amp-star-rating text-danger">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star off"></i><i class="bi bi-star off"></i><i class="bi bi-star off"></i>
                            </div>
                        </div>
                        <p class="text-secondary my-2 fst-italic" style="font-size:13px">"Đường chỉ may ở tay áo hơi lỏng lẻo, vải mỏng hơn so với đợt trước mua. Cần thương hiệu kiểm tra lại chất lượng đầu ra."</p>
                        <div class="d-flex justify-content-between align-items-center pt-2 mt-1 border-top">
                            <span class="amp-pill amp-pill-red" style="font-size:11px;padding:2px 8px">Mới</span>
                            <a href="/QuanLy/DanhGia/DanhSach" class="text-dark fw-bold text-decoration-none" style="font-size:12.5px"><i class="bi bi-reply-fill"></i> Trả lời</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. Line Chart Doanh Thu (Figma style)
    const ctxDoanhThu = document.getElementById('chartDoanhThuLine');
    if (ctxDoanhThu) {
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nhanNgay));
        const dataValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaTriDoanhThu));

        // Sample data if empty
        const finalLabels = labels.length > 0 ? labels : ['05/09', '06/09', '07/09', '08/09', '09/09', '10/09', '11/09'];
        const finalData = dataValues.length > 0 ? dataValues : [28000000, 45000000, 32000000, 58000000, 39000000, 62000000, 48000000];

        new Chart(ctxDoanhThu, {
            type: 'line',
            data: {
                labels: finalLabels,
                datasets: [{
                    label: 'Doanh thu',
                    data: finalData,
                    borderColor: '#C5A880',
                    backgroundColor: 'rgba(197, 168, 128, 0.12)',
                    borderWidth: 2.5,
                    pointBackgroundColor: '#C5A880',
                    pointBorderColor: '#FFFFFF',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    tension: 0.35,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#111827',
                        padding: 10,
                        titleFont: { size: 12 },
                        bodyFont: { size: 13, weight: 'bold' },
                        callbacks: {
                            label: function(context) {
                                return new Intl.NumberFormat('vi-VN').format(context.parsed.y) + ' ₫';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 11, family: 'Inter' }, color: '#9CA3AF' }
                    },
                    y: {
                        border: { dash: [4, 4] },
                        grid: { color: '#F3F4F6' },
                        ticks: {
                            font: { size: 11, family: 'Inter' },
                            color: '#9CA3AF',
                            callback: function(val) {
                                if (val >= 1000000) return (val / 1000000) + 'M';
                                return val;
                            }
                        }
                    }
                }
            }
        });
    }

    // 2. Donut Chart Trạng Thái Đơn Hàng (Figma style)
    const ctxDonut = document.getElementById('chartTrangThaiDonHang');
    if (ctxDonut) {
        new Chart(ctxDonut, {
            type: 'doughnut',
            data: {
                labels: ['Đã giao thành công', 'Đang xử lý', 'Đang vận chuyển', 'Đã hủy / Trả hàng'],
                datasets: [{
                    data: [120, 36, 18, 10],
                    backgroundColor: ['#10B981', '#F59E0B', '#3B82F6', '#EF4444'],
                    borderWidth: 3,
                    borderColor: '#FFFFFF'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ' + context.parsed + ' đơn';
                            }
                        }
                    }
                }
            }
        });
    }
</script>
}
