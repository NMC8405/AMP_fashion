@model BaoCaoViewModel
@{
    ViewData["Title"] = "Báo cáo thống kê";
    var nhanNgay = Model.DoanhThuTheoNgay.Select(d => (Model.KyBaoCao == "homnay" ? d.Ngay.ToString("HH:mm") : d.Ngay.ToString("dd/MM"))).ToList();
    var giaTriDoanhThu = Model.DoanhThuTheoNgay.Select(d => d.DoanhThu).ToList();

    var dmLabels = Model.DoanhThuTheoDanhMuc.Keys.ToList();
    var dmValues = Model.DoanhThuTheoDanhMuc.Values.ToList();

    var tongDonDonut = Model.DonHangTheoTrangThai.Values.Sum();
    var statusLabels = Model.DonHangTheoTrangThai.Keys.ToList();
    var statusValues = Model.DonHangTheoTrangThai.Values.ToList();

    var mauTrangThai = new Dictionary<string, string>
    {
        { "Đã giao hàng", "#10B981" },
        { "Đã xác nhận", "#3B82F6" },
        { "Đang giao hàng", "#06B6D4" },
        { "Chờ xác nhận", "#F59E0B" },
        { "Chờ thanh toán", "#8B5CF6" },
        { "Đã hủy", "#EF4444" }
    };

    var statusColorsList = statusLabels.Select(l => mauTrangThai.ContainsKey(l) ? mauTrangThai[l] : "#6B7280").ToList();
}

<!-- ACTION & PERIOD FILTER BAR -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div class="d-flex gap-1 bg-white p-1 rounded-pill border shadow-sm">
        <a href="/QuanLy/Dashboard/BaoCao?kyBaoCao=homnay" class="btn btn-sm rounded-pill px-3 @(Model.KyBaoCao == "homnay" ? "btn-dark" : "text-secondary")" style="font-size:13px;font-weight:600">Hôm nay</a>
        <a href="/QuanLy/Dashboard/BaoCao?kyBaoCao=7ngay" class="btn btn-sm rounded-pill px-3 @(Model.KyBaoCao == "7ngay" ? "btn-dark" : "text-secondary")" style="font-size:13px;font-weight:600">7 ngày</a>
        <a href="/QuanLy/Dashboard/BaoCao?kyBaoCao=30ngay" class="btn btn-sm rounded-pill px-3 @(Model.KyBaoCao == "30ngay" ? "btn-dark" : "text-secondary")" style="font-size:13px;font-weight:600">30 ngày</a>
        <a href="/QuanLy/Dashboard/BaoCao?kyBaoCao=3thang" class="btn btn-sm rounded-pill px-3 @(Model.KyBaoCao == "3thang" ? "btn-dark" : "text-secondary")" style="font-size:13px;font-weight:600">3 tháng</a>
        <a href="/QuanLy/Dashboard/BaoCao?kyBaoCao=12thang" class="btn btn-sm rounded-pill px-3 @(Model.KyBaoCao == "12thang" ? "btn-dark" : "text-secondary")" style="font-size:13px;font-weight:600">12 tháng</a>
    </div>

    <div class="d-flex align-items-center gap-2">
        <a href="/QuanLy/Dashboard/XuatFile" class="amp-btn-dark-pill shadow-sm">
            <i class="bi bi-file-earmark-arrow-down"></i> Xuất báo cáo
        </a>
    </div>
</div>

<!-- 4 TOP KPI CARDS (DỮ LIỆU THỰC TẾ & SO SÁNH CHUẨN XÁC THEO TỪNG KỲ) -->
<div class="amp-kpi-4grid">
    <div class="amp-kpi-card-modern">
        <div class="lbl">
            <span>TỔNG DOANH THU</span>
            <i class="bi bi-graph-up text-secondary"></i>
        </div>
        <div class="val">@Model.TongDoanhThu.ToString("N0") ₫</div>
        <div class="sub @(Model.DoanhThuTangTruong < 0 ? "down" : (Model.DoanhThuTangTruong == 0 ? "text-secondary" : ""))">
            @if (Model.DoanhThuTangTruong > 0)
            {
                <i class="bi bi-arrow-up-short fs-5 text-success"></i><span class="text-success fw-semibold">+@Model.DoanhThuTangTruong.ToString("0.0")%</span>
            }
            else if (Model.DoanhThuTangTruong < 0)
            {
                <i class="bi bi-arrow-down-short fs-5 text-danger"></i><span class="text-danger fw-semibold">@Model.DoanhThuTangTruong.ToString("0.0")%</span>
            }
            else
            {
                <i class="bi bi-dash fs-5"></i><span>0.0%</span>
            }
            <span class="ms-1">@Model.NhanSoSanh</span>
        </div>
    </div>

    <div class="amp-kpi-card-modern">
        <div class="lbl">
            <span>TỔNG ĐƠN HÀNG</span>
            <i class="bi bi-bag-check text-secondary"></i>
        </div>
        <div class="val">@Model.TongDonHang.ToString("N0") đơn</div>
        <div class="sub @(Model.DonHangTangTruong < 0 ? "down" : (Model.DonHangTangTruong == 0 ? "text-secondary" : ""))">
            @if (Model.DonHangTangTruong > 0)
            {
                <i class="bi bi-arrow-up-short fs-5 text-success"></i><span class="text-success fw-semibold">+@Model.DonHangTangTruong.ToString("0.0")%</span>
            }
            else if (Model.DonHangTangTruong < 0)
            {
                <i class="bi bi-arrow-down-short fs-5 text-danger"></i><span class="text-danger fw-semibold">@Model.DonHangTangTruong.ToString("0.0")%</span>
            }
            else
            {
                <i class="bi bi-dash fs-5"></i><span>0.0%</span>
            }
            <span class="ms-1">@Model.NhanSoSanh</span>
        </div>
    </div>

    <div class="amp-kpi-card-modern">
        <div class="lbl">
            <span>GIÁ TRỊ ĐƠN TRUNG BÌNH (AOV)</span>
            <i class="bi bi-calculator text-secondary"></i>
        </div>
        <div class="val">@Model.GiaTriDonHangTrungBinh.ToString("N0") ₫</div>
        <div class="sub @(Model.GiaTriDonHangTangTruong < 0 ? "down" : (Model.GiaTriDonHangTangTruong == 0 ? "text-secondary" : ""))">
            @if (Model.GiaTriDonHangTangTruong > 0)
            {
                <i class="bi bi-arrow-up-short fs-5 text-success"></i><span class="text-success fw-semibold">+@Model.GiaTriDonHangTangTruong.ToString("0.0")%</span>
            }
            else if (Model.GiaTriDonHangTangTruong < 0)
            {
                <i class="bi bi-arrow-down-short fs-5 text-danger"></i><span class="text-danger fw-semibold">@Model.GiaTriDonHangTangTruong.ToString("0.0")%</span>
            }
            else
            {
                <i class="bi bi-dash fs-5"></i><span>0.0%</span>
            }
            <span class="ms-1">@Model.NhanSoSanh</span>
        </div>
    </div>

    <div class="amp-kpi-card-modern">
        <div class="lbl">
            <span>LỢI NHUẬN ƯỚC TÍNH</span>
            <i class="bi bi-cash-stack text-secondary"></i>
        </div>
        <div class="val">@Model.LoiNhuan.ToString("N0") ₫</div>
        <div class="sub @(Model.LoiNhuanTangTruong < 0 ? "down" : (Model.LoiNhuanTangTruong == 0 ? "text-secondary" : ""))">
            @if (Model.LoiNhuanTangTruong > 0)
            {
                <i class="bi bi-arrow-up-short fs-5 text-success"></i><span class="text-success fw-semibold">+@Model.LoiNhuanTangTruong.ToString("0.0")%</span>
            }
            else if (Model.LoiNhuanTangTruong < 0)
            {
                <i class="bi bi-arrow-down-short fs-5 text-danger"></i><span class="text-danger fw-semibold">@Model.LoiNhuanTangTruong.ToString("0.0")%</span>
            }
            else
            {
                <i class="bi bi-dash fs-5"></i><span>0.0%</span>
            }
            <span class="ms-1">@Model.NhanSoSanh</span>
        </div>
    </div>
</div>

<!-- CHARTS ROW: DOANH THU THEO THỜI GIAN & TRẠNG THÁI ĐƠN HÀNG -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="amp-box-card h-100 mb-0">
            <h5 class="fw-bold mb-1" style="font-size:16px;">Biểu đồ Doanh thu</h5>
            <div class="text-muted mb-3" style="font-size:12.5px;">Theo dõi xu hướng dòng tiền theo kỳ báo cáo (@Model.KyBaoCao)</div>
            <div style="height: 280px; position: relative;">
                <canvas id="chartBaoCaoLine"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="amp-box-card h-100 mb-0 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold mb-1" style="font-size:16px;">Trạng thái đơn hàng</h5>
                <div class="text-muted mb-3" style="font-size:12.5px;">Tỷ trọng đơn hàng trong kỳ báo cáo</div>
                
                @if (tongDonDonut > 0)
                {
                    <div style="height: 200px; position: relative;" class="my-2">
                        <canvas id="chartBaoCaoDonut"></canvas>
                    </div>
                    <div class="mt-3 pt-3 border-top">
                        @foreach (var kvp in Model.DonHangTheoTrangThai)
                        {
                            var pct = tongDonDonut > 0 ? Math.Round((double)kvp.Value / tongDonDonut * 100, 1) : 0;
                            var color = mauTrangThai.ContainsKey(kvp.Key) ? mauTrangThai[kvp.Key] : "#6B7280";
                            <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:12.5px">
                                <span class="d-flex align-items-center gap-2">
                                    <span style="width:10px;height:10px;border-radius:50%;background:@color"></span>
                                    @kvp.Key (@pct%)
                                </span>
                                <span class="fw-bold">@kvp.Value đơn</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center py-5 text-center text-muted">
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-3" style="width:60px;height:60px">
                            <i class="bi bi-inbox fs-3 text-secondary"></i>
                        </div>
                        <h6 class="fw-semibold text-dark mb-1">Chưa có đơn hàng</h6>
                        <p class="small text-muted mb-0">Không có đơn hàng nào phát sinh trong kỳ này.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- BAR CHART: DOANH THU THEO DANH MỤC -->
<div class="amp-box-card mb-4">
    <h5 class="fw-bold mb-1" style="font-size:16px;">Doanh thu theo danh mục (Triệu VNĐ)</h5>
    <div class="text-muted mb-3" style="font-size:12.5px;">Phân bổ doanh thu theo từng nhóm hàng thời trang</div>
    <div style="height: 240px; position: relative;">
        <canvas id="chartBaoCaoCategory"></canvas>
    </div>
</div>

<!-- PRODUCT EFFICIENCY TABLE (CHI TIẾT HIỆU QUẢ SẢN PHẨM THỰC TẾ) -->
<div class="amp-box-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0" style="font-size:16px;">Chi tiết hiệu quả sản phẩm</h5>
        <span class="text-muted" style="font-size:13px;">Xếp theo doanh thu đóng góp</span>
    </div>

    <div class="table-responsive">
        <table class="amp-table-modern">
            <thead>
                <tr>
                    <th>SẢN PHẨM</th>
                    <th>ĐÃ BÁN</th>
                    <th>DOANH THU</th>
                    <th>LỢI NHUẬN</th>
                    <th>TĂNG TRƯỞNG</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ChiTietHieuQuaSanPham.Any())
                {
                    @foreach (var sp in Model.ChiTietHieuQuaSanPham)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(sp.HinhAnh) ? "/images/placeholder.png" : sp.HinhAnh)" 
                                         class="amp-prod-thumb" alt="@sp.TenSanPham" onerror="this.src='/images/placeholder.png'" />
                                    <div>
                                        <div class="fw-bold text-dark">@sp.TenSanPham</div>
                                        <div class="text-muted" style="font-size:11.5px">@sp.MaSanPham</div>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-semibold">@sp.DaBan</td>
                            <td class="fw-bold">@sp.DoanhThu.ToString("N0") ₫</td>
                            <td class="text-success fw-semibold">@sp.LoiNhuan.ToString("N0") ₫</td>
                            <td>
                                <span class="amp-pill amp-pill-green" style="font-size:11.5px">
                                    +@sp.TangTruong.ToString("0.0")%
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary opacity-50"></i>
                            Không có sản phẩm nào phát sinh doanh thu trong kỳ này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // 1. Line Chart Doanh Thu
    const ctxLine = document.getElementById('chartBaoCaoLine');
    if (ctxLine) {
        const lineLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nhanNgay));
        const lineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaTriDoanhThu));

        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: lineLabels,
                datasets: [{
                    label: 'Doanh thu',
                    data: lineData,
                    borderColor: '#111827',
                    backgroundColor: 'rgba(17, 24, 39, 0.06)',
                    borderWidth: 2.5,
                    pointBackgroundColor: '#111827',
                    pointBorderColor: '#FFFFFF',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    tension: 0.35,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Doanh thu: ' + Number(context.raw).toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#9CA3AF' } },
                    y: {
                        beginAtZero: true,
                        border: { dash: [4, 4] },
                        grid: { color: '#F3F4F6' },
                        ticks: {
                            color: '#9CA3AF',
                            callback: function(v) {
                                if (v >= 1000000) return (v / 1000000).toLocaleString('vi-VN') + 'M';
                                if (v >= 1000) return (v / 1000).toLocaleString('vi-VN') + 'k';
                                return v;
                            }
                        }
                    }
                }
            }
        });
    }

    // 2. Donut Chart Trạng Thái (Chỉ render khi có dữ liệu)
    const ctxDonut = document.getElementById('chartBaoCaoDonut');
    if (ctxDonut) {
        const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusLabels));
        const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusValues));
        const statusColors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusColorsList));

        new Chart(ctxDonut, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusData,
                    backgroundColor: statusColors,
                    borderWidth: 3,
                    borderColor: '#FFFFFF'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: { legend: { display: false } }
            }
        });
    }

    // 3. Bar Chart Category Revenue
    const ctxCategory = document.getElementById('chartBaoCaoCategory');
    if (ctxCategory) {
        const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dmLabels));
        const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dmValues.Select(v => Math.Round(v / 1000000m, 2))));

        new Chart(ctxCategory, {
            type: 'bar',
            data: {
                labels: catLabels,
                datasets: [{
                    label: 'Doanh thu (Triệu VNĐ)',
                    data: catData,
                    backgroundColor: '#111827',
                    borderRadius: 6,
                    barThickness: 36
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Doanh thu: ' + Number(context.raw).toLocaleString('vi-VN') + ' Triệu VNĐ';
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#4B5563', font: { weight: 'bold' } } },
                    y: {
                        beginAtZero: true,
                        border: { dash: [4, 4] },
                        grid: { color: '#F3F4F6' },
                        ticks: { color: '#9CA3AF', callback: v => v + 'M' }
                    }
                }
            }
        });
    }
</script>
}
