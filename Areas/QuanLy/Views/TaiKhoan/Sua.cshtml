@model TaiKhoanFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
    var returnUrl = ViewBag.ReturnUrl as string ?? (Model.VaiTro == VaiTro.KhachHang ? "/QuanLy/TaiKhoan/KhachHang" : "/QuanLy/TaiKhoan/NhanVien");
}
<div class="amp-box-card" style="max-width:600px;margin:0 auto">
    <h5 class="fw-bold mb-4" style="font-size:18px">Cập nhật tài khoản</h5>

    <form asp-action="Sua" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size:13px"></div>

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label fw-semibold" style="font-size:13px">Họ và tên <span class="text-danger">*</span></label>
            <input asp-for="HoTen" class="form-control" />
            <span asp-validation-for="HoTen" class="text-danger" style="font-size:12px"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold" style="font-size:13px">Địa chỉ Email <span class="text-danger">*</span></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger" style="font-size:12px"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SoDienThoai" class="form-label fw-semibold" style="font-size:13px">Số điện thoại <span class="text-muted fw-normal">(tùy chọn)</span></label>
            <input asp-for="SoDienThoai" class="form-control" />
            <span asp-validation-for="SoDienThoai" class="text-danger" style="font-size:12px"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VaiTro" class="form-label fw-semibold" style="font-size:13px">Vai trò hệ thống <span class="text-danger">*</span></label>
            <select asp-for="VaiTro" class="form-select" asp-items="Html.GetEnumSelectList<VaiTro>()"></select>
            <span asp-validation-for="VaiTro" class="text-danger" style="font-size:12px"></span>
        </div>

        <div class="mb-4">
            <label asp-for="MatKhau" class="form-label fw-semibold" style="font-size:13px">Mật khẩu mới <span class="text-muted fw-normal">(để trống nếu không đổi)</span></label>
            <input asp-for="MatKhau" class="form-control" placeholder="Để trống nếu giữ nguyên mật khẩu cũ" />
            <span asp-validation-for="MatKhau" class="text-danger" style="font-size:12px"></span>
        </div>

        <div class="d-flex align-items-center gap-3 pt-3 border-top">
            <button type="submit" class="amp-btn-dark-pill">
                <i class="bi bi-check2"></i> Lưu thay đổi
            </button>
            <a href="@returnUrl" class="btn btn-light rounded-pill px-4" style="font-size:13.5px;font-weight:600">
                Hủy bỏ
            </a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
