@model TaiKhoanFormViewModel
@{
    ViewData["Title"] = "Thêm tài khoản";
}
<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
<div class="amp-table-card" style="padding:24px;max-width:560px">
    <form asp-action="Them" method="post">
        <div class="amp-field">
            <label asp-for="HoTen" class="amp-label"></label>
            <input asp-for="HoTen" class="form-control" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>
        <div class="amp-field">
            <label asp-for="Email" class="amp-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="amp-field">
            <label asp-for="SoDienThoai" class="amp-label"><span class="opt">(tùy chọn)</span></label>
            <input asp-for="SoDienThoai" class="form-control" />
        </div>
        <div class="amp-field">
            <label asp-for="VaiTro" class="amp-label"></label>
            <select asp-for="VaiTro" class="form-select" asp-items="Html.GetEnumSelectList<VaiTro>()"></select>
        </div>
        <div class="amp-field">
            <label asp-for="MatKhau" class="amp-label"></label>
            <input asp-for="MatKhau" class="form-control" placeholder="Tối thiểu 6 ký tự" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="amp-btn amp-btn-primary">Tạo tài khoản</button>
            <a asp-action="DanhSach" class="amp-btn amp-btn-outline">Hủy</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
