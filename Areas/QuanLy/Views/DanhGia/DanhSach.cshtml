@model List<DanhGia>
@{
    ViewData["Title"] = "Đánh giá";
    int? soSao = ViewBag.SoSao;
    string trangThai = ViewBag.TrangThai ?? "";
    int tongDanhGia = ViewBag.TongDanhGia ?? Model.Count;
    int choPhanHoi = ViewBag.ChoPhanHoi ?? Model.Count(x => string.IsNullOrEmpty(x.PhanHoi));
    int daPhanHoi = ViewBag.DaPhanHoi ?? Model.Count(x => !string.IsNullOrEmpty(x.PhanHoi));
}

<!-- FILTER & SEARCH BAR (FIGMA STYLE) -->
<div class="amp-action-bar">
    <form method="get" class="d-flex align-items-center gap-3 flex-wrap flex-grow-1">
        <div class="amp-search-box">
            <i class="bi bi-search"></i>
            <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" placeholder="Tìm tên, email, số điện thoại, nội dung..." />
        </div>

        <select name="soSao" class="amp-select-filter" onchange="this.form.submit()">
            <option value="">Số sao: 1-5 sao</option>
            <option value="5" selected="@(soSao == 5)">5 sao ⭐⭐⭐⭐⭐</option>
            <option value="4" selected="@(soSao == 4)">4 sao ⭐⭐⭐⭐</option>
            <option value="3" selected="@(soSao == 3)">3 sao ⭐⭐⭐</option>
            <option value="2" selected="@(soSao == 2)">2 sao ⭐⭐</option>
            <option value="1" selected="@(soSao == 1)">1 sao ⭐</option>
        </select>

        <select name="trangThai" class="amp-select-filter" onchange="this.form.submit()">
            <option value="">Trạng thái: Tất cả</option>
            <option value="cho_phan_hoi" selected="@(trangThai == "cho_phan_hoi")">Chờ phản hồi (@choPhanHoi)</option>
            <option value="da_phan_hoi" selected="@(trangThai == "da_phan_hoi")">Đã phản hồi (@daPhanHoi)</option>
        </select>
    </form>
</div>

<!-- REVIEW TABLE CARD -->
<div class="amp-box-card">
    <div class="table-responsive">
        <table class="amp-table-modern">
            <thead>
                <tr>
                    <th>KHÁCH HÀNG</th>
                    <th>SẢN PHẨM</th>
                    <th style="min-width:125px;width:125px">SỐ SAO</th>
                    <th style="min-width:240px">NỘI DUNG ĐÁNH GIÁ</th>
                    <th>PHẢN HỒI</th>
                    <th>NGÀY ĐÁNH GIÁ</th>
                    <th>THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-chat-square-quote fs-2 d-block mb-2 text-secondary"></i>
                            Không tìm thấy đánh giá nào theo điều kiện lọc.
                        </td>
                    </tr>
                }
                @foreach (var dg in Model)
                {
                    var initial = dg.NguoiDung != null && !string.IsNullOrEmpty(dg.NguoiDung.HoTen) ? dg.NguoiDung.HoTen.Substring(0, 1).ToUpper() : "K";
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" 
                                     style="width:34px;height:34px;background:#F3F4F6;color:#111827;font-size:13px;flex-shrink:0">
                                    @initial
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@(dg.NguoiDung?.HoTen ?? "Khách hàng")</div>
                                    <div class="text-muted" style="font-size:11.5px">@(dg.NguoiDung?.Email ?? "")</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark" style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                @(dg.SanPham?.TenSanPham ?? "Sản phẩm")
                            </div>
                            @if (dg.DonHang != null)
                            {
                                <div class="text-muted" style="font-size:11px">Đơn: #@dg.DonHang.MaDonHang</div>
                            }
                        </td>
                        <td style="white-space:nowrap;min-width:125px">
                            <div class="amp-star-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= dg.SoSao)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star-fill off"></i>
                                    }
                                }
                            </div>
                        </td>
                        <td>
                            <p class="mb-1 text-dark" style="font-size:13px;line-height:1.4">
                                "@dg.NoiDung"
                            </p>
                            @if (!string.IsNullOrEmpty(dg.PhanHoi))
                            {
                                <div class="p-2 rounded bg-light border mt-1" style="font-size:12px;color:#4B5563">
                                    <strong class="text-dark">Phản hồi của shop:</strong> @dg.PhanHoi
                                </div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(dg.PhanHoi))
                            {
                                <span class="amp-pill amp-pill-green">Đã phản hồi</span>
                            }
                            else
                            {
                                <span class="amp-pill amp-pill-red">Chờ phản hồi</span>
                            }
                        </td>
                        <td style="font-size:12px;color:#6B7280;white-space:nowrap">
                            @dg.NgayDanhGia.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 py-1 text-white fw-semibold" 
                                        style="font-size:12px" data-bs-toggle="modal" data-bs-target="#modalPhanHoi_@dg.Id">
                                    <i class="bi bi-reply-fill"></i> Trả lời
                                </button>
                                
                                <form asp-action="Xoa" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa đánh giá này?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@dg.Id" />
                                    <button type="submit" class="amp-action-link danger border-0" style="cursor:pointer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Modal Phản Hồi Đánh Giá -->
                            <div class="modal fade" id="modalPhanHoi_@dg.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <form asp-action="PhanHoi" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@dg.Id" />
                                            <div class="modal-header">
                                                <h6 class="modal-title fw-bold">Trả lời đánh giá của @(dg.NguoiDung?.HoTen ?? "Khách hàng")</h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body py-3">
                                                <div class="p-3 rounded bg-light mb-3" style="font-size:13px">
                                                    <div class="fw-bold mb-1">Sản phẩm: @(dg.SanPham?.TenSanPham)</div>
                                                    <div class="text-secondary fst-italic">"@dg.NoiDung"</div>
                                                </div>
                                                <label class="form-label fw-bold" style="font-size:13px">Nội dung phản hồi từ thương hiệu AMP:</label>
                                                <textarea name="noiDungPhanHoi" rows="4" class="form-control" placeholder="Cảm ơn bạn đã phản hồi. AMP chân thành xin lỗi..." required>@dg.PhanHoi</textarea>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Đóng</button>
                                                <button type="submit" class="amp-btn-dark-pill" style="padding:7px 18px">Gửi phản hồi</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="amp-pagination-wrap">
        <div>Hiển thị <strong>@Model.Count</strong> của <strong>@tongDanhGia</strong> đánh giá</div>
    </div>
</div>
