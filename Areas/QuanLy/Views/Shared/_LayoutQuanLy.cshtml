@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string c) => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Quản lý AMP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="amp-admin-shell">
        <aside class="amp-admin-sidebar">
            <a href="/" class="logo">AMP <span style="font-size:11px;font-weight:500;opacity:.6">Quản lý</span></a>

            <div class="grp-label">Tổng quan</div>
            <a href="/QuanLy/Dashboard" class="@(IsActive("Dashboard") ? "active" : "")"><i class="bi bi-speedometer2"></i> Thống kê</a>

            <div class="grp-label">Bán hàng</div>
            <a href="/QuanLy/SanPham/DanhSach" class="@(IsActive("SanPham") ? "active" : "")"><i class="bi bi-hanger"></i> Sản phẩm</a>
            <a href="/QuanLy/DanhMuc/DanhSach" class="@(IsActive("DanhMuc") ? "active" : "")"><i class="bi bi-tags"></i> Danh mục</a>
            <a href="/QuanLy/ThuocTinh/DanhSach" class="@(IsActive("ThuocTinh") ? "active" : "")"><i class="bi bi-palette"></i> Màu sắc &amp; Size</a>
            <a href="/QuanLy/MaGiamGia/DanhSach" class="@(IsActive("MaGiamGia") ? "active" : "")"><i class="bi bi-ticket-perforated"></i> Mã giảm giá</a>
            <a href="/QuanLy/DonHang/DanhSach" class="@(IsActive("DonHang") ? "active" : "")"><i class="bi bi-bag-check"></i> Đơn hàng</a>

            @if (User.IsInRole("QuanTriVien"))
            {
                <div class="grp-label">Quản trị</div>
                <a href="/QuanLy/TaiKhoan/DanhSach" class="@(IsActive("TaiKhoan") ? "active" : "")"><i class="bi bi-people"></i> Tài khoản</a>
            }

            <div class="grp-label">Khác</div>
            <a href="/"><i class="bi bi-shop"></i> Về trang cửa hàng</a>
            <form asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                <button type="submit" class="btn p-0 border-0 bg-transparent w-100 text-start" style="all:unset;cursor:pointer;display:flex;align-items:center;gap:11px;padding:11px 10px;border-radius:3px;font-size:13.5px;font-weight:600;color:#cfcfca;width:100%">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
            </form>
        </aside>

        <div class="amp-admin-main">
            <div class="amp-admin-topbar">
                <div>
                    <button class="amp-mobile-toggle d-inline-flex d-md-none" data-admin-toggle type="button" style="margin-right:10px"><i class="bi bi-list"></i></button>
                    <h1 style="display:inline">@ViewData["Title"]</h1>
                </div>
                <div class="who"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name <span class="ms-1" style="opacity:.6">(@(User.IsInRole("QuanTriVien") ? "Quản trị viên" : "Nhân viên"))</span></div>
            </div>

            @if (TempData["ThongBao"] != null)
            {
                <div class="amp-alert amp-alert-success" data-auto-dismiss><i class="bi bi-check-circle me-1"></i> @TempData["ThongBao"]</div>
            }
            @if (TempData["Loi"] != null)
            {
                <div class="amp-alert amp-alert-danger" data-auto-dismiss><i class="bi bi-exclamation-circle me-1"></i> @TempData["Loi"]</div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
