@model List<SanPham>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var danhMucs = ViewBag.DanhMucs as List<DanhMuc> ?? new();
}
<div class="amp-table-toolbar">
    <form method="get" class="d-flex gap-2 flex-wrap">
        <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm theo tên sản phẩm..." style="width:240px" />
        <select name="danhMucId" class="form-select" style="width:180px" onchange="this.form.submit()">
            <option value="">Tất cả danh mục</option>
            @foreach (var dm in danhMucs)
            {
                <option value="@dm.Id" selected="@(ViewBag.DanhMucId == dm.Id)">@dm.TenDanhMuc</option>
            }
        </select>
        <button type="submit" class="amp-btn amp-btn-outline">Lọc</button>
    </form>
    <a asp-action="Them" class="amp-btn amp-btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm</a>
</div>

<div class="amp-table-card">
    <table class="amp-table">
        <thead>
            <tr>
                <th></th><th>Tên sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Không có sản phẩm nào.</td></tr>
            }
            @foreach (var sp in Model)
            {
                <tr>
                    <td><img src="@sp.HinhAnhChinh" class="amp-thumb-sm" /></td>
                    <td>@sp.TenSanPham</td>
                    <td>@sp.DanhMuc?.TenDanhMuc</td>
                    <td>
                        @sp.GiaHienThi.ToString("N0")₫
                        @if (sp.DangGiamGia)
                        {
                            <div><del style="color:var(--amp-muted-light);font-size:11.5px">@sp.GiaGoc.ToString("N0")₫</del></div>
                        }
                    </td>
                    <td>@sp.TongSoLuongTon</td>
                    <td>
                        @if (sp.TrangThaiHienThi)
                        {
                            <span class="amp-status amp-status-da-giao">Đang hiển thị</span>
                        }
                        else
                        {
                            <span class="amp-status amp-status-da-huy">Đã ẩn</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Sua" asp-route-id="@sp.Id" class="amp-btn amp-btn-outline amp-btn-sm">Sửa</a>
                            <form asp-action="AnHien" method="post">
                                <input type="hidden" name="id" value="@sp.Id" />
                                <button type="submit" class="amp-btn amp-btn-outline amp-btn-sm">@(sp.TrangThaiHienThi ? "Ẩn" : "Hiện")</button>
                            </form>
                            <form asp-action="Xoa" method="post" onsubmit="return confirm('Xóa sản phẩm này?')">
                                <input type="hidden" name="id" value="@sp.Id" />
                                <button type="submit" class="amp-btn amp-btn-danger amp-btn-sm">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{ int trang = ViewBag.Trang; int tongTrang = ViewBag.TongTrang; }
@if (tongTrang > 1)
{
    <div class="amp-pagination">
        @for (int i = 1; i <= tongTrang; i++)
        {
            <a href="@Url.Action("DanhSach", new { tuKhoa = ViewBag.TuKhoa, danhMucId = ViewBag.DanhMucId, trang = i })" class="@(i == trang ? "active" : "")">@i</a>
        }
    </div>
}
