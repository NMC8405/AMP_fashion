@model MaGiamGia
<div class="amp-table-card" style="padding:24px;max-width:640px">
    <div class="amp-field">
        <label asp-for="Ma" class="amp-label"></label>
        <input asp-for="Ma" class="form-control" style="text-transform:uppercase" placeholder="VD: SALE50K" />
        <span asp-validation-for="Ma" class="text-danger"></span>
    </div>
    <div class="amp-field">
        <label asp-for="MoTa" class="amp-label"><span class="opt">(tùy chọn)</span></label>
        <input asp-for="MoTa" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="amp-field">
                <label asp-for="LoaiGiamGia" class="amp-label"></label>
                <select asp-for="LoaiGiamGia" class="form-select" asp-items="Html.GetEnumSelectList<LoaiGiamGia>()"></select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="amp-field">
                <label asp-for="GiaTri" class="amp-label">Giá trị (% hoặc đ)</label>
                <input asp-for="GiaTri" class="form-control" type="number" />
                <span asp-validation-for="GiaTri" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="amp-field">
                <label asp-for="GiaTriDonHangToiThieu" class="amp-label"></label>
                <input asp-for="GiaTriDonHangToiThieu" class="form-control" type="number" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="amp-field">
                <label asp-for="SoTienGiamToiDa" class="amp-label"><span class="opt">(áp dụng cho loại %)</span></label>
                <input asp-for="SoTienGiamToiDa" class="form-control" type="number" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="amp-field">
                <label asp-for="SoLuongToiDa" class="amp-label"><span class="opt">(để trống = không giới hạn)</span></label>
                <input asp-for="SoLuongToiDa" class="form-control" type="number" />
            </div>
        </div>
        <div class="col-md-6"></div>
        <div class="col-md-6">
            <div class="amp-field">
                <label asp-for="NgayBatDau" class="amp-label"></label>
                <input asp-for="NgayBatDau" class="form-control" type="date" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="amp-field">
                <label asp-for="NgayKetThuc" class="amp-label"></label>
                <input asp-for="NgayKetThuc" class="form-control" type="date" />
                <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-check form-switch">
        <input asp-for="TrangThaiHoatDong" class="form-check-input" type="checkbox" role="switch" />
        <label asp-for="TrangThaiHoatDong" class="form-check-label">Kích hoạt mã giảm giá</label>
    </div>
</div>
